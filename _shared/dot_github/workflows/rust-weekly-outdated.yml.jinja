{% raw %}name: Weekly Dependency Update

on:
  schedule:
    # Every Monday at 09:00 UTC
    - cron: '0 9 * * 1'
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: write

env:
  CARGO_TERM_COLOR: always

jobs:
  update-dependencies:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - uses: actions-rs/toolchain@v1
        with:
          profile: minimal
          toolchain: stable
          override: true

      - name: Install cargo-audit
        run: cargo install cargo-audit

      - name: Update dependencies
        run: cargo update

      - name: Run cargo audit after update
        run: cargo audit

      - name: Verify build after update
        run: cargo build --all-features

      - name: Run tests after update
        run: cargo test --all-features

      - name: Create Pull Request
        uses: peter-evans/create-pull-request@v6
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          commit-message: |
            chore(deps): weekly cargo update

            Automated weekly dependency update generated by the
            Weekly Dependency Update workflow.
          title: 'chore(deps): weekly cargo update'
          body: |
            ## Summary

            Automated weekly dependency update. This PR was created by the
            `Weekly Dependency Update` workflow.

            ### What changed
            - `cargo update` applied to update Cargo.lock
            - `cargo audit` verified no new vulnerabilities
            - `cargo build --all-features` verified the project builds
            - `cargo test --all-features` verified tests pass

            If this PR has no changes, the workflow found no available updates.
          branch: chore/deps/weekly-update
          delete-branch: true
          labels: |
            dependencies
            automated
{% endraw %}

{
  "name": "{{ module_name }}",
  "version": "0.1.0",
  "description": "{{ description }}",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .ts,.mts",
    "lint:fix": "eslint . --ext .ts,.mts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    {% if keywords %}"{{ keywords }}"{% endif %}
  ],
  "author": {
    "name": "{{ author_name }}",
    "email": "{{ author_email }}"
  },
  "license": "{{ license }}",
  "repository": {
    "type": "git",
    "url": "{{ repository_url }}"
  },
  "engines": {
    "node": ">={{ node_version }}"
  },
  "packageManager": "pnpm@*",
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

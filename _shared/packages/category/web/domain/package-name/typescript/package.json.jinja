{
  "name": "{{ module_name }}",
  "version": "0.1.0",
  "description": "{{ description }}",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .ts,.mts",
    "lint:fix": "eslint . --ext .ts,.mts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    {% if keywords %}"{{ keywords }}"{% endif %}
  ],
  "author": {
    "name": "{{ author_name }}",
    "email": "{{ author_email }}"
  },
  "license": "{{ license }}",
  "repository": {
    "type": "git",
    "url": "{{ repository_url }}"
  },
  "devDependencies": {
    {% include "partials.bak/partials/package-json-partials/core-typescript-dev-deps.partial.json.jinja" %}
    {% include "partials.bak/partials/package-json-partials/library-typescript-dev-deps.partial.json.jinja" %}
    "@total-typescript/shoehorn": "catalog:"
  },
  {% include "partials.bak/partials/package-json-partials/package-json-tooling.partial.json.jinja" %}
  "modeline": "/* vim: set ft=json: */"
}

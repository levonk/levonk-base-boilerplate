# Swift CLI Development Commands

{% include "partials.bak/partials/justfile-partials/logging.jinja" %}

# Devbox auto-detection: run impl target directly if in devbox,
# re-exec via devbox run if not, or fail with doctor diagnostic.
_devbox target *args:
    #!/usr/bin/env bash
    {{_log}}
    if [ "${DEVBOX_SHELL_ENABLED:-0}" = "1" ]; then
        exec just "{{target}}" {{args}}
    elif command -v devbox >/dev/null 2>&1; then
        exec devbox run -- just "{{target}}" {{args}}
    else
        log_error "devbox not found in PATH."
        log_warn "Running doctor to diagnose environment issues..."
        just doctor 2>/dev/null || true
        exit 1
    fi

# Default recipe
default:
    @just --list

# Standard development recipes (REQUIRED)
clean:
    @just _devbox clean_impl

dev:
    @just _devbox dev_impl

build:
    @just _devbox build_impl

test:
    @just _devbox test_impl

lint:
    @just _devbox lint_impl

typecheck:
    @just _devbox typecheck_impl

[private]
clean_impl:
    swift package clean

[private]
dev_impl:
    swift run

[private]
build_impl:
    swift build

[private]
test_impl:
    swift test

[private]
lint_impl:
    swiftlint

[private]
typecheck_impl:
    swift build

# Bootstrap recipes (REQUIRED)
bootstrap:
    @just _devbox bootstrap_impl

[private]
bootstrap_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Resolve Swift packages in background if not present
    [ -d .build ] || swift package resolve &

    log_end "Swift CLI bootstrap complete"

# Health and diagnostics (REQUIRED)
doctor:
    @just _devbox doctor_impl

[private]
doctor_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Check Swift CLI development environment
    echo "🦉 Swift CLI environment:"
    echo "📦 Swift version:"
    swift --version
    echo ""
    echo "🛠️  Development tools:"
    command -v swiftlint || echo "swiftlint not found"
    command -v swiftformat || echo "swiftformat not found"
    echo ""
    echo "✅ Swift CLI environment is ready!"

# Install dependencies (Swift package resolve)
resolve:
    @just _devbox resolve_impl

[private]
resolve_impl:
    swift package resolve

# Build debug
build-debug:
    @just _devbox build-debug_impl

[private]
build-debug_impl:
    swift build

# Build release
build-release:
    @just _devbox build-release_impl

[private]
build-release_impl:
    swift build -c release

# Run tests
test-swift:
    @just _devbox test-swift_impl

[private]
test-swift_impl:
    swift test

# Run tests with coverage
test-coverage:
    @just _devbox test-coverage_impl

[private]
test-coverage_impl:
    swift test --enable-code-coverage

# Lint code
lint-code:
    @just _devbox lint-code_impl

[private]
lint-code_impl:
    swiftlint

# Format code
format:
    @just _devbox format_impl

[private]
format_impl:
    swiftformat .

# Format check
format-check:
    @just _devbox format-check_impl

[private]
format-check_impl:
    swiftformat --lint .

# Clean build artifacts
clean-artifacts:
    @just _devbox clean-artifacts_impl

[private]
clean-artifacts_impl:
    swift package clean

# Run application
run:
    @just _devbox run_impl

[private]
run_impl:
    swift run

# Update dependencies
update:
    @just _devbox update_impl

[private]
update_impl:
    swift package update

# Dependency synchronization
{% include 'partials.bak/partials/justfile-partials/swift-deps-sync.jinja' %}

# Development setup
setup:
    @just _devbox setup_impl

[private]
setup_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    just bootstrap
    log_end "Swift CLI development environment ready"

# Help target
help:
    @echo "🦉 Swift CLI Application"
    @echo ""
    @echo "Standard commands:"
    @echo "  just bootstrap    - Initialize the development environment"
    @echo "  just build        - Build the project"
    @echo "  just test         - Run tests"
    @echo "  just lint         - Run linting"
    @echo "  just typecheck    - Run type checking"
    @echo "  just dev           - Run in development mode"
    @echo "  just clean         - Clean build artifacts"
    @echo "  just doctor        - Check environment health"
    @echo ""
    @echo "Swift-specific commands:"
    @echo "  just resolve       - Resolve Swift packages"
    @echo "  just update        - Update dependencies"
    @echo "  just format        - Format code"
    @echo "  just test-coverage - Run tests with coverage"
    @echo "  just sync-deps     - Sync Package.resolved with Package.swift"
    @echo "  just pre-commit    - Run pre-commit checks"

# Airflow Node Development Commands

{% include "partials.bak/partials/justfile-partials/logging.jinja" %}

# Devbox auto-detection: run impl target directly if in devbox,
# re-exec via devbox run if not, or fail with doctor diagnostic.
_devbox target *args:
    #!/usr/bin/env bash
    {{_log}}
    if [ "${DEVBOX_SHELL_ENABLED:-0}" = "1" ]; then
        exec just "{{target}}" {{args}}
    elif command -v devbox >/dev/null 2>&1; then
        exec devbox run -- just "{{target}}" {{args}}
    else
        log_error "devbox not found in PATH."
        log_warn "Running doctor to diagnose environment issues..."
        just doctor 2>/dev/null || true
        exit 1
    fi

# Detect NX binary
NX_BIN := `command -v nx || echo ""`
NX_AVAILABLE := if NX_BIN != "" { "true" } else { "false" }

# Default recipe
default:
    @just --list

# Standard development recipes (REQUIRED)
clean:
    @just _devbox clean_impl

dev:
    @just _devbox dev_impl

build:
    @just _devbox build_impl

test:
    @just _devbox test_impl

lint:
    @just _devbox lint_impl

typecheck:
    @just _devbox typecheck_impl

[private]
clean_impl:
    rm -rf dist/ out/

[private]
dev_impl:
    pnpm dev

[private]
build_impl:
    @if [ "{{ NX_AVAILABLE }}" = "true" ]; then nx docker:build; else docker build -t airflow-task .; fi

[private]
test_impl:
    pnpm test

[private]
lint_impl:
    pnpm lint

[private]
typecheck_impl:
    pnpm typecheck

# Bootstrap recipes (REQUIRED)
bootstrap:
    @just _devbox bootstrap_impl

[private]
bootstrap_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Bootstrapping"
    # Install dependencies in background if not present
    [ -d node_modules/ ] || pnpm install &

    log_info "Installing pnpm and NX..."
    npm install -g pnpm@latest
    if [ "{{ NX_AVAILABLE }}" = "false" ]; then pnpm add -g nx@latest; fi
    log_end "Bootstrap complete"

# NX Commands
nx-build:
    @just _devbox nx-build_impl

[private]
nx-build_impl:
    @if [ "{{ NX_AVAILABLE }}" = "true" ]; then nx docker:build; else docker build -t airflow-task .; fi

nx-up:
    @just _devbox nx-up_impl

[private]
nx-up_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    if [ "{{ NX_AVAILABLE }}" = "true" ]; then nx docker:up; else log_warn "Use docker compose directly"; fi

nx-down:
    @just _devbox nx-down_impl

[private]
nx-down_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    if [ "{{ NX_AVAILABLE }}" = "true" ]; then nx docker:down; else log_warn "Use docker compose directly"; fi

nx-affected:
    @just _devbox nx-affected_impl

[private]
nx-affected_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    if [ "{{ NX_AVAILABLE }}" = "true" ]; then nx affected; else log_warn "NX not available"; fi

nx-graph:
    @just _devbox nx-graph_impl

[private]
nx-graph_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    if [ "{{ NX_AVAILABLE }}" = "true" ]; then nx graph; else log_warn "NX not available"; fi

nx-clear-cache:
    @just _devbox nx-clear-cache_impl

[private]
nx-clear-cache_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    if [ "{{ NX_AVAILABLE }}" = "true" ]; then nx reset; else log_warn "NX not available"; fi

nx-install:
    @just _devbox nx-install_impl

[private]
nx-install_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    pnpm add -g nx@latest
    log_end "NX installed globally"

# Health and diagnostics (REQUIRED)
doctor:
    @just _devbox doctor_impl

[private]
doctor_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Check Airflow Node environment
    echo "🐳 Docker version:"
    docker --version
    echo ""
    echo "🛠️  Development tools:"
    command -v just || echo "just not found"
    echo ""
    echo "📦 Node environment:"
    node --version
    pnpm --version
    echo "📊 NX: {{ if NX_AVAILABLE }}$(nx --version){{ else }}not installed{{ endif }}"
    echo ""
    echo "✅ Airflow Node environment is ready!"

# Dependency synchronization
{% include 'partials.bak/partials/justfile-partials/typescript-deps-sync.jinja' %}

# Help target
help:
    @echo "🐳 Airflow Node - Available Commands"
    @echo ""
    @echo "Standard commands:"
    @echo "  just bootstrap    - Initialize the development environment"
    @echo "  just build        - Build the project"
    @echo "  just test         - Run tests"
    @echo "  just lint         - Run linting"
    @echo "  just typecheck    - Run type checking"
    @echo "  just dev          - Run in development mode"
    @echo "  just clean         - Clean build artifacts"
    @echo "  just doctor        - Check environment health"
    @echo ""
    @echo "NX commands (if available):"
    @echo "  just nx-build     - Build with NX"
    @echo "  just nx-up        - Start services with NX"
    @echo "  just nx-down      - Stop services with NX"
    @echo ""
    @echo "TypeScript-specific commands:"
    @echo "  just sync-deps    - Sync lock file with package.json"
    @echo "  just pre-commit   - Run pre-commit checks"

# NextJS Development Commands
# Standard justfile following ADR-20260101001

{% include "partials.bak/partials/justfile-partials/logging.jinja" %}

# Devbox auto-detection: run impl target directly if in devbox,
# re-exec via devbox run if not, or fail with doctor diagnostic.
_devbox target *args:
    #!/usr/bin/env bash
    {{_log}}
    if [ "${DEVBOX_SHELL_ENABLED:-0}" = "1" ]; then
        exec just "{{target}}" {{args}}
    elif command -v devbox >/dev/null 2>&1; then
        exec devbox run -- just "{{target}}" {{args}}
    else
        log_error "devbox not found in PATH."
        log_warn "Running doctor to diagnose environment issues..."
        just doctor 2>/dev/null || true
        exit 1
    fi

# Default recipe
default:
    @just --list

# Normal targets - Developer interface (REQUIRED)
clean:
    @just _devbox clean_impl

dev:
    @just _devbox dev_impl

build:
    @just _devbox build_impl

test:
    @just _devbox test_impl

lint:
    @just _devbox lint_impl

typecheck:
    @just _devbox typecheck_impl

# Bootstrap recipes (REQUIRED)
bootstrap:
    @just _devbox bootstrap_impl

[private]
bootstrap_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Install dependencies in background if not present
    [ -d node_modules/ ] || pnpm install &

    # Initialize tkr for task management
    if command -v tkr >/dev/null 2>&1; then
      if [ ! -d ".tickets" ]; then
        log_info "Initializing tkr..."
        tkr init || log_warn "tkr init failed"
      else
        log_info "tkr already initialized"
      fi
    fi

    # Create memory directory structure for Obsidian
    log_info "Setting up memory structure..."
    mkdir -p memory/{00-inbox,01-projects,02-decisions,03-patterns,04-learnings,05-references,98-logs,99-daily}

    # Create Obsidian configuration if needed
    if [ ! -d ".obsidian" ]; then
      mkdir -p .obsidian
      echo "# Obsidian configuration" > .obsidian/config.md
    fi

    log_end "NextJS bootstrap complete"

# Prime recipes (REQUIRED)
prime:
    @just _devbox prime_impl

[private]
prime_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Update repository and index documentation
    log_info "Updating repository..."
    git fetch || log_warn "git fetch failed (check remote connectivity)"

    # qmd memory indexing
    if command -v qmd >/dev/null 2>&1; then
        log_info "Indexing documentation with qmd..."
        qmd index docs/ internal-docs/ memory/ README.md || log_warn "qmd indexing failed"
        log_info "qmd indexing complete."
    else
        log_info "Skipping qmd (not installed)"
    fi

    log_end "NextJS priming complete"

# Health and diagnostics (REQUIRED)
doctor:
    @just _devbox doctor_impl

[private]
doctor_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Check NextJS environment
    echo "🔍 Checking NextJS development environment..."
    if ! pnpm --version >/dev/null 2>&1; then
        echo "❌ Error: pnpm not found" >&2
        echo "💡 Suggestion: Install pnpm" >&2
        exit 1
    fi
    if ! node --version >/dev/null 2>&1; then
        echo "❌ Error: node not found" >&2
        echo "💡 Suggestion: Install Node.js" >&2
        exit 1
    fi
    if [ ! -f package.json ]; then
        echo "❌ Error: package.json not found (expected in project root)" >&2
        exit 1
    fi
    echo "✅ OK: Node.js + pnpm + package.json present"

    # Check for memory management tools
    if command -v qmd >/dev/null 2>&1; then
        echo "✅ OK: qmd available for memory search"
    else
        echo "⚠️  WARNING: qmd not found (install with: cargo install qmd)"
    fi

    if command -v tkr >/dev/null 2>&1; then
        echo "✅ OK: tkr available for task management"
    else
        echo "⚠️  WARNING: tkr not found (install from: https://github.com/levonk/tkr)"
    fi

    # Check for memory structure
    if [ -d memory ]; then
        echo "✅ OK: memory/ directory found"
    else
        echo "⚠️  WARNING: memory/ directory missing (run 'just bootstrap' to create)"
    fi

    echo "🚀 Ready to develop NextJS application!"

# Quality checks (OPTIONAL but RECOMMENDED)
quality:
    @just _devbox quality_impl

[private]
quality_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    just lint_impl
    just test_impl
    just typecheck_impl

# Memory and task management targets (NEW)
doc-search:
    @just _devbox doc-search_impl

[private]
doc-search_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Search memory and documentation with qmd
    if command -v qmd >/dev/null 2>&1; then
        query="${1:-.}"  # Default to show all if no query
        qmd search "$query" | head -20
    else
        echo "qmd not found - falling back to ripgrep..."
        rg --type md "$query" docs/ internal-docs/ memory/ || true
    fi

tasks:
    @just _devbox tasks_impl

[private]
tasks_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # List current tasks
    if command -v tkr >/dev/null 2>&1; then
        tkr list --status=open
    else
        echo "tkr not found"
    fi

task-ready:
    @just _devbox task-ready_impl

[private]
task-ready_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Get next available task
    if command -v tkr >/dev/null 2>&1; then
        tkr ready
    else
        log_warn "tkr not found"
    fi

task-start:
    @just _devbox task-start_impl

[private]
task-start_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Start working on available task
    if command -v tkr >/dev/null 2>&1; then
        task_id=$(tkr ready | head -1 | cut -d' ' -f1)
        if [ -n "$task_id" ]; then
            tkr start "$task_id"
            log_info "Started task: $task_id"
        else
            log_info "No available tasks"
        fi
    else
        log_warn "tkr not found"
    fi

# Language-specific commands for NextJS
# Internal targets - Actual implementation
[private]
clean_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Clean build artifacts
    rm -rf .next out dist
    log_end "Build artifacts removed"

[private]
build_impl:
    # Build for production
    pnpm build

[private]
test_impl:
    # Run tests
    pnpm test

[private]
lint_impl:
    # Lint code
    pnpm lint

[private]
typecheck_impl:
    # Type checking
    pnpm typecheck

[private]
dev_impl:
    # Run the application in development mode
    pnpm dev

# Additional NextJS-specific targets
test-watch:
    @just _devbox test-watch_impl

[private]
test-watch_impl:
    # Run tests in watch mode
    pnpm test --watch

lint-fix:
    @just _devbox lint-fix_impl

[private]
lint-fix_impl:
    # Lint and fix
    pnpm lint --fix

format:
    @just _devbox format_impl

[private]
format_impl:
    # Format code
    pnpm format

start:
    @just _devbox start_impl

[private]
start_impl:
    # Start production server
    pnpm start

types:
    @just _devbox types_impl

[private]
types_impl:
    # Generate types
    pnpm types

storybook:
    @just _devbox storybook_impl

[private]
storybook_impl:
    # Run Storybook (if included)
    pnpm storybook

build-storybook:
    @just _devbox build-storybook_impl

[private]
build-storybook_impl:
    # Build Storybook (if included)
    pnpm build-storybook

e2e:
    @just _devbox e2e_impl

[private]
e2e_impl:
    # E2E tests
    pnpm e2e

e2e-watch:
    @just _devbox e2e-watch_impl

[private]
e2e-watch_impl:
    # E2E tests in watch mode
    pnpm e2e --watch

migrate:
    @just _devbox migrate_impl

[private]
migrate_impl:
    # Database migrations (if applicable)
    pnpm migrate

reset-db:
    @just _devbox reset-db_impl

[private]
reset-db_impl:
    # Database reset (if applicable)
    pnpm reset-db

env-setup:
    @just _devbox env-setup_impl

[private]
env-setup_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Environment management
    cp .env.example .env.local
    log_info "Environment file created. Please update .env.local with your settings."

logs:
    @just _devbox logs_impl

[private]
logs_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # View logs
    log_info "NextJS logs:"
    tail -f .next/server.log 2>/dev/null || log_warn "No server logs found"

# Dependency synchronization
{% include 'partials.bak/partials/justfile-partials/typescript-deps-sync.jinja' %}

# Development setup (OPTIONAL)
setup:
    @just _devbox setup_impl

[private]
setup_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    just bootstrap
    log_end "NextJS development environment ready"

# Help target

# ===== IMPLEMENTATION TARGETS =====

[private]
bootstrap_impl:
    #!/usr/bin/env bash
    {{_log}}
    # Internal bootstrap logic called by devbox init_hook
    set -euo pipefail

    if ! command -v copier >/dev/null 2>&1; then
      log_info "[bootstrap] Installing copier via pip..."
      pip install copier
      log_info "[bootstrap] copier installed."
    fi
    if ! command -v just >/dev/null 2>&1; then
      log_info "[bootstrap] Installing just via Nix..."
      nix profile add nixpkgs#just --extra-experimental-features "nix-command flakes"
      log_info "[bootstrap] just installed."
    fi

    # Install universal-ctags via Nix
    if ! command -v ctags >/dev/null 2>&1; then
      log_info "[bootstrap] Installing universal-ctags via Nix..."
      nix profile add nixpkgs#universal-ctags --extra-experimental-features "nix-command flakes"
      log_info "[bootstrap] universal-ctags installed."
    fi

    # Install uv via Nix
    if ! command -v uv >/dev/null 2>&1; then
      log_info "[bootstrap] Installing uv via Nix..."
      nix profile add nixpkgs#uv --extra-experimental-features "nix-command flakes"
      log_info "[bootstrap] uv installed."
    fi

    # Install https://github.com/Cranot/roam-code
    if ! command -v roam >/dev/null 2>&1; then
      log_info "[bootstrap] Installing roam-code..."
      uv tool install roam-code
      log_info "[bootstrap] roam-code installed."
      log_info "[bootstrap] Running roam-code priming command..."
      roam init
      roam understand
      log_info "[bootstrap] roam-code priming complete."
    fi

    # Install desloppify
    if ! command -v desloppify >/dev/null 2>&1; then
      log_info "[bootstrap] Installing desloppify..."
      # Try Nix first, fallback to binary download
      if nix profile install nixpkgs#desloppify --extra-experimental-features "nix-command flakes" 2>/dev/null; then
        log_info "[bootstrap] desloppify installed via Nix."
      else
        log_info "[bootstrap] Installing desloppify via binary download..."
        mkdir -p "$HOME/.local/bin"
        curl -L https://github.com/peteromallet/desloppify/releases/latest/download/desloppify-$(uname -s)-$(uname -m) -o "$HOME/.local/bin/desloppify"
        chmod +x "$HOME/.local/bin/desloppify"
        export PATH="$HOME/.local/bin:$PATH"
        mkdir -p .claude/skills/desloppify && { curl -fsSL https://raw.githubusercontent.com/peteromallet/desloppify/main/docs/SKILL.md; printf '\n\n'; curl -fsSL https://raw.githubusercontent.com/peteromallet/desloppify/main/docs/CLAUDE.md; } > .claude/skills/desloppify/SKILL.md
        mkdir -p .agents/skills/desloppify "${CODEX_HOME:-$HOME/.codex}/skills/desloppify" && { curl -fsSL https://raw.githubusercontent.com/peteromallet/desloppify/main/docs/SKILL.md; printf '\n\n'; curl -fsSL https://raw.githubusercontent.com/peteromallet/desloppify/main/docs/CODEX.md; } | tee .agents/skills/desloppify/SKILL.md > "${CODEX_HOME:-$HOME/.codex}/skills/desloppify/SKILL.md"
        log_info "[bootstrap] desloppify installed via binary."
      fi
    fi
    if ! command -v desloppify >/dev/null 2>&1; then
      log_warn "[bootstrap] desloppify install failed"
    else
      log_info "[bootstrap] Running desloppify priming command..."
      desloppify scan --path .
      log_info "[bootstrap] desloppify priming complete."
    fi

    # Install qmd for memory search
    if ! command -v qmd >/dev/null 2>&1; then
      log_info "[bootstrap] Installing qmd for memory search..."
      if cargo install qmd 2>/dev/null; then
        log_info "[bootstrap] qmd installed via cargo."
      else
        log_warn "[bootstrap] qmd install failed, will use ripgrep fallback"
      fi
    fi

    # Initialize tkr for task management
    if ! command -v tkr >/dev/null 2>&1; then
      log_info "[bootstrap] Installing tkr for task management..."
      if command -v cargo >/dev/null 2>&1 && cargo install tkr 2>/dev/null; then
        log_info "[bootstrap] tkr installed via cargo."
      else
        log_warn "[bootstrap] tkr not available (install from: https://github.com/levonk/tkr)"
      fi
    fi

    # Initialize tkr if available
    if command -v tkr >/dev/null 2>&1; then
      if [ ! -d ".tickets" ]; then
        log_info "[bootstrap] Initializing tkr..."
        tkr init || log_warn "[bootstrap] tkr init failed"
      else
        log_info "[bootstrap] tkr already initialized"
      fi
    fi

    # Create memory directory structure for Obsidian
    log_info "[bootstrap] Setting up memory structure..."
    mkdir -p memory/{00-inbox,01-projects,02-decisions,03-patterns,04-learnings,05-references,98-logs,99-daily}

    # Create Obsidian configuration if needed
    if [ ! -d ".obsidian" ]; then
      mkdir -p .obsidian
      echo "# Obsidian configuration" > .obsidian/config.md
    fi

    log_info "[bootstrap] Memory structure created"
    log_info "[bootstrap] Shared partials environment ready!"

[private]
prime_impl:
    #!/usr/bin/env bash
    {{_log}}
    # Internal prime logic for code indexing and analysis tools
    set -euo pipefail

    log_info "[prime] Starting code indexing and analysis priming..."

    # Update repository from remote
    log_info "[prime] Updating repository..."
    git fetch || log_warn "[prime] git fetch failed (check remote connectivity)"

    # Run universal-ctags indexing
    if command -v ctags >/dev/null 2>&1; then
        log_info "[prime] Running universal-ctags indexing..."
        ctags --recurse=yes --tag-relative=yes --exclude=.git --exclude=node_modules --exclude=target --exclude=dist --exclude=build --exclude=__pycache__ --exclude=.venv --exclude=vendor -f .tags || log_warn "[prime] ctags indexing completed with warnings"
        log_info "[prime] universal-ctags indexing complete."
    else
        log_warn "[prime] Skipping universal-ctags (not installed)"
    fi

    # Run roam-code indexing
    if command -v roam >/dev/null 2>&1; then
        log_info "[prime] Running roam-code indexing..."
        roam understand || log_warn "[prime] roam-code indexing completed with warnings"
        log_info "[prime] roam-code indexing complete."
    else
        log_warn "[prime] Skipping roam-code (not installed)"
    fi

    # Run desloppify scanning
    if command -v desloppify >/dev/null 2>&1; then
        log_info "[prime] Running desloppify scanning..."
        desloppify scan --path . || log_warn "[prime] desloppify scanning completed with warnings"
        log_info "[prime] desloppify scanning complete."
    else
        log_warn "[prime] Skipping desloppify (not installed)"
    fi

    # qmd memory indexing
    if command -v qmd >/dev/null 2>&1; then
        log_info "[prime] Indexing documentation with qmd..."
        qmd index docs/ internal-docs/ memory/ README.md || log_warn "[prime] qmd indexing failed"
        log_info "[prime] qmd indexing complete."
    else
        log_warn "[prime] Skipping qmd (not installed)"
    fi

    log_info "[prime] Code and documentation indexing complete!"

[private]
doctor_impl:
    #!/usr/bin/env bash
    {{_log}}
    set -euo pipefail
    MISSING=0
    for tool in copier just git ctags uv desloppify roam qmd tkr; do
      if command -v $tool >/dev/null 2>&1; then
        printf "[doctor] %-8s OK\n" "$tool"
      else
        log_warn "[doctor] MISSING: $tool"
        MISSING=$((MISSING+1))
      fi
    done

    # Check for indexing artifacts
    log_info "[doctor] Checking indexing artifacts..."
    if [ -f .tags ]; then
        log_info "[doctor] .tags file found (ctags indexing)"
    else
        log_warn "[doctor] .tags file missing (run 'just prime' to generate)"
    fi

    if [ -d .roam ]; then
        log_info "[doctor] .roam directory found (roam-code indexing)"
    else
        log_warn "[doctor] .roam directory missing (run 'just prime' to generate)"
    fi

    if [ -f .desloppify ]; then
        log_info "[doctor] .desloppify file found (desloppify scanning)"
    else
        log_warn "[doctor] .desloppify file missing (run 'just prime' to generate)"
    fi

    # Check for memory management setup
    if [ -d memory ]; then
        log_info "[doctor] memory/ directory found (Obsidian memory structure)"
    else
        log_warn "[doctor] memory/ directory missing (run 'just bootstrap' to create)"
    fi

    if [ -d .tickets ]; then
        log_info "[doctor] .tickets directory found (tkr task management)"
    else
        log_warn "[doctor] .tickets directory missing (run 'just bootstrap' to create)"
    fi

    if [ "$MISSING" -ne 0 ]; then
        log_error "[doctor] Missing $MISSING required tool(s). Run 'just bootstrap' to install."
        exit 1
    fi
    log_info "[doctor] Shared partials environment looks good."

[private]
quality_impl:
    #!/usr/bin/env bash
    {{_log}}
    just lint
    just test
    just typecheck

[private]
doc-search_impl query=".":
    #!/usr/bin/env bash
    {{_log}}
    # Search memory and documentation with qmd
    if command -v qmd >/dev/null 2>&1; then
        qmd search "{{query}}" | head -20
    else
        log_warn "qmd not found - falling back to ripgrep..."
        rg --type md "{{query}}" docs/ internal-docs/ memory/ || true
    fi

[private]
tasks_impl:
    #!/usr/bin/env bash
    {{_log}}
    # List current tasks
    if command -v tkr >/dev/null 2>&1; then
        tkr list --status=open
    else
        log_warn "tkr not found"
    fi

[private]
task-ready_impl:
    #!/usr/bin/env bash
    {{_log}}
    # Get next available task
    if command -v tkr >/dev/null 2>&1; then
        tkr ready
    else
        log_warn "tkr not found"
    fi

[private]
task-start_impl:
    #!/usr/bin/env bash
    {{_log}}
    # Start working on available task
    if command -v tkr >/dev/null 2>&1; then
        task_id=$(tkr ready | head -1 | cut -d' ' -f1)
        if [ -n "$task_id" ]; then
            tkr start "$task_id"
            log_info "Started task: $task_id"
        else
            log_warn "No available tasks"
        fi
    else
        log_warn "tkr not found"
    fi

[private]
setup_impl:
    #!/usr/bin/env bash
    {{_log}}
    # Project-specific setup
    log_info "Development environment ready!"

[private]
init_impl:
    #!/usr/bin/env bash
    {{_log}}
    log_info "🔧 Initializing boilerplate shared partials environment..."
    log_info "📁 Creating directory structure..."
    mkdir -p apps/infrastructure/docker
    mkdir -p apps/web/typescript/nextjs
    mkdir -p packages/category/web/domain/package-name/typescript
    mkdir -p packages/category/web/domain/package-name/python3
    log_info "✅ Shared partials structure initialized"

[private]
validate_impl:
    #!/usr/bin/env bash
    {{_log}}
    log_info "🔍 Validating shared partials structure..."
    find _shared -name "*.jinja" | head -10
    log_info "✅ Validation complete"

[private]
test-wrapper_impl:
    #!/usr/bin/env bash
    {{_log}}
    log_info "🧪 Testing copier-wrapper script..."
    if [ -f ../copier-wrapper.sh ]; then
        log_info "✅ copier-wrapper.sh found"
        ../copier-wrapper.sh --help | head -5
    else
        log_error "❌ copier-wrapper.sh not found"
    fi

[private]
list-shared_impl:
    #!/usr/bin/env bash
    {{_log}}
    log_info "📋 Available shared partials:"
    find _shared -name "*.jinja" -exec echo "  - {}" \; 2>/dev/null || log_warn "  No shared partials found"

[private]
watch_impl:
    #!/usr/bin/env bash
    {{_log}}
    log_info "👀 Watching for changes in shared partials..."
    while inotifywait -r -e modify,create,delete _shared/ 2>/dev/null; do
        log_info "🔄 Change detected, cleaning partials.bak directories..."
        just clean
    done

[private]
build_impl:
    #!/usr/bin/env bash
    {{_log}}
    log_info "🔨 Building shared partials..."
    log_info "✅ Build complete (no build steps needed for shared partials)"

[private]
test_impl:
    #!/usr/bin/env bash
    {{_log}}
    log_info "🧪 Testing shared partials..."
    just test-wrapper
    log_info "✅ Tests complete"

[private]
lint_impl:
    #!/usr/bin/env bash
    {{_log}}
    log_info "🔍 Linting shared partials..."
    find _shared -name "*.jinja" -exec echo "Checking {}" \; | head -10
    log_info "✅ Lint complete"

[private]
typecheck_impl:
    #!/usr/bin/env bash
    {{_log}}
    log_info "🔍 Type checking shared partials..."
    log_info "✅ Type check complete (no types to check in shared partials)"

[private]
dev_impl:
    #!/usr/bin/env bash
    {{_log}}
    log_info "🚀 Starting development environment..."
    log_info "📁 Shared partials location: $(pwd)"
    log_info "🛠️  Use: copier-wrapper.sh copy <template> <destination>"

[private]
clean_impl:
    #!/usr/bin/env bash
    {{_log}}
    log_info "🧹 Cleaning generated partials.bak directories..."
    find . -name "partials.bak" -type d -exec rm -rf {} + 2>/dev/null || true
    log_info "✅ Clean complete"

[private]
clean-all_impl:
    #!/usr/bin/env bash
    {{_log}}
    log_info "🧹 Deep cleaning shared partials..."
    find . -name "partials.bak" -type d -exec rm -rf {} + 2>/dev/null || true
    find . -name "*.tmp" -delete 2>/dev/null || true
    find . -name ".DS_Store" -delete 2>/dev/null || true
    log_info "✅ Deep clean complete"

# pnpm Monorepo Development Commands
# Standard justfile following ADR-20260131001
#
# Output is quiet by default (warnings + errors only).
# Set JUST_LOG=1 for all output, JUST_LOG=startend for start/end markers.

# Set default shell and recipe settings
set shell := ["bash", "-euo", "pipefail"]

{% include "partials.bak/partials/justfile-partials/logging.jinja" %}

# Devbox auto-detection: run impl target directly if in devbox,
# re-exec via devbox run if not, or fail with doctor diagnostic.
_devbox target *args:
    #!/usr/bin/env bash
    {{_log}}
    if [ "${DEVBOX_SHELL_ENABLED:-0}" = "1" ]; then
        exec just "{{target}}" {{args}}
    elif command -v devbox >/dev/null 2>&1; then
        exec devbox run -- just "{{target}}" {{args}}
    else
        log_error "devbox not found in PATH."
        log_warn "Running doctor to diagnose environment issues..."
        just doctor 2>/dev/null || true
        exit 1
    fi

# Default recipe
default:
    @just --list

# --- public targets (devbox-aware) ------------------------------------------

# Install dependencies and prepare the project for development.
bootstrap:
    @just _devbox bootstrap_impl

# Prime = bootstrap + build + test (full first-time setup).
prime:
    @just _devbox prime_impl

# Check required tools and report environment health.
doctor:
    @just _devbox doctor_impl

# Remove build artifacts and caches.
clean:
    @just _devbox clean_impl

# Build all apps/packages via Nx.
build:
    @just _devbox build_impl

# Lint all apps/packages via Nx + ESLint.
lint:
    @just _devbox lint_impl

# Run unit tests via Nx + Vitest.
test:
    @just _devbox test_impl

# Typecheck all apps/packages via Nx.
typecheck:
    @just _devbox typecheck_impl

# Start dev servers for all apps via Nx.
dev:
    @just _devbox dev_impl

# Release: build + changeset publish.
release:
    @just _devbox release_impl

# Deploy (placeholder — wired per environment in CI/CD).
deploy:
    @just _devbox deploy_impl

# Run all quality checks (lint + test + typecheck).
quality:
    @just _devbox quality_impl

# Search internal-docs for a keyword.
doc-search query:
    @just _devbox doc-search_impl "{{query}}"

# List available tasks (this file + Nx targets).
tasks:
    @just _devbox tasks_impl

# Check whether the current task is ready to start (deps satisfied).
task-ready:
    @just _devbox task-ready_impl

# Start a task (creates a branch + moves the task to in-progress).
task-start:
    @just _devbox task-start_impl

# --- convenience aliases (delegate to _devbox) ------------------------------

# Fix linting issues via Nx.
lint-fix:
    @just _devbox lint-fix_impl

# Format code with prettier.
format:
    @just _devbox format_impl

# Check formatting with prettier.
format-check:
    @just _devbox format-check_impl

# Run unit tests only via Nx.
test-unit:
    @just _devbox test-unit_impl

# Generate coverage reports via Nx.
test-coverage:
    @just _devbox test-coverage_impl

# Remove build artifacts and node_modules.
clean-hard:
    @just _devbox clean-hard_impl

# Show Nx project graph.
nx-graph:
    @just _devbox nx-graph_impl

# Run affected projects via Nx.
nx-affected:
    @just _devbox nx-affected_impl

# Clear Nx cache.
nx-clear-cache:
    @just _devbox nx-clear-cache_impl

# Development setup (bootstrap + git hooks).
setup:
    @just _devbox setup_impl

# --- implementation targets (assume devbox active) --------------------------

[private]
bootstrap_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Install dependencies synchronously so eslint/prettier are available
    # in node_modules/.bin before any quality checks run.
    if [ ! -d node_modules/ ]; then
      log_start "Installing dependencies with pnpm"
      # Use --no-frozen-lockfile for initial install since no lockfile exists yet.
      # The shared .npmrc enables frozen-lockfile for CI reproducibility.
      if [ ! -f pnpm-lock.yaml ]; then
        pnpm install --no-frozen-lockfile
      else
        pnpm install
      fi
      log_end "Dependencies installed"
    else
      log_info "node_modules/ already present"
    fi

    # Initialize tkr for task management
    if command -v tkr >/dev/null 2>&1; then
      if [ ! -d ".tickets" ]; then
        log_info "Initializing tkr"
        tkr init || log_warn "tkr init failed"
      else
        log_info "tkr already initialized"
      fi
    fi

    # Create memory directory structure for Obsidian
    log_info "Setting up memory structure"
    mkdir -p memory/{00-inbox,01-projects,02-decisions,03-patterns,04-learnings,05-references,98-logs,99-daily}

    if [ ! -d ".obsidian" ]; then
      mkdir -p .obsidian
      echo "# Obsidian configuration" > .obsidian/config.md
    fi

    # Verify eslint/prettier are now available via node_modules/.bin
    if command -v eslint >/dev/null 2>&1; then
      log_info "eslint available: $(eslint --version)"
    else
      log_warn "eslint not found on PATH after pnpm install"
    fi
    if command -v prettier >/dev/null 2>&1; then
      log_info "prettier available: $(prettier --version)"
    else
      log_warn "prettier not found on PATH after pnpm install"
    fi

    log_end "pnpm monorepo bootstrap complete"

[private]
prime_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Updating repository"
    git fetch || log_warn "git fetch failed (check remote connectivity)"

    # qmd memory indexing
    if command -v qmd >/dev/null 2>&1; then
        log_info "Indexing documentation with qmd"
        qmd index docs/ internal-docs/ memory/ README.md || log_warn "qmd indexing failed"
    else
        log_info "Skipping qmd (not installed)"
    fi

    log_end "pnpm monorepo priming complete"

[private]
doctor_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "🔍 Checking pnpm monorepo development environment..."

    if ! command -v pnpm >/dev/null 2>&1; then
        echo "❌ Error: pnpm not found" >&2
        exit 1
    fi
    if ! command -v node >/dev/null 2>&1; then
        echo "❌ Error: node not found" >&2
        exit 1
    fi
    if [ ! -f package.json ]; then
        echo "❌ Error: package.json not found (expected in monorepo root)" >&2
        exit 1
    fi
    echo "✅ OK: Node.js + pnpm + package.json present"

    # Check for installed dependencies
    if [ -d node_modules/ ]; then
        echo "✅ OK: node_modules/ present (dependencies installed)"
    else
        echo "⚠️  WARNING: node_modules/ missing — run 'just bootstrap' to install"
    fi

    # Check eslint/prettier availability (from node_modules/.bin after pnpm install)
    if command -v eslint >/dev/null 2>&1; then
        echo "✅ OK: eslint available ($(eslint --version))"
    else
        echo "⚠️  WARNING: eslint not on PATH — run 'just bootstrap' to install dependencies"
    fi
    if command -v prettier >/dev/null 2>&1; then
        echo "✅ OK: prettier available ($(prettier --version))"
    else
        echo "⚠️  WARNING: prettier not on PATH — run 'just bootstrap' to install dependencies"
    fi

    # Check for nx
    if [ -f node_modules/.bin/nx ]; then
        echo "✅ OK: nx available (via node_modules/.bin)"
    else
        echo "⚠️  WARNING: nx not installed — run 'just bootstrap' to install dependencies"
    fi

    # Check for memory management tools
    if command -v qmd >/dev/null 2>&1; then
        echo "✅ OK: qmd available for memory search"
    else
        echo "⚠️  WARNING: qmd not found (install with: cargo install qmd)"
    fi

    if command -v tkr >/dev/null 2>&1; then
        echo "✅ OK: tkr available for task management"
    else
        echo "⚠️  WARNING: tkr not found (install from: https://github.com/levonk/tkr)"
    fi

    if [ -d memory ]; then
        echo "✅ OK: memory/ directory found"
    else
        echo "⚠️  WARNING: memory/ directory missing (run 'just bootstrap' to create)"
    fi

    # Check versioned git hooks path (submodule-integrity pre-commit).
    hooks_path="$(git config core.hooksPath 2>/dev/null || true)"
    if [ "$hooks_path" = "scripts/hooks" ] && [ -x scripts/hooks/pre-commit ]; then
        echo "✅ OK: git hooks configured (core.hooksPath=scripts/hooks)"
    else
        echo "⚠️  WARNING: git hooks not configured (run 'just setup' to enable submodule-integrity check)"
    fi

    echo "🚀 Ready to develop pnpm monorepo!"

[private]
clean_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    rm -rf .next out dist .nx/cache
    log_end "Build artifacts removed"

[private]
build_impl:
    pnpm build

[private]
test_impl:
    pnpm test

[private]
lint_impl:
    pnpm lint

[private]
typecheck_impl:
    pnpm typecheck

[private]
dev_impl:
    pnpm dev

[private]
release_impl:
    pnpm release

[private]
deploy_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_warn "No deploy target configured for pnpm monorepo — wire per environment in CI/CD."
    exit 1

[private]
lint-fix_impl:
    pnpm lint:fix

[private]
format_impl:
    pnpm format

[private]
format-check_impl:
    pnpm format:check

[private]
test-unit_impl:
    pnpm test:unit

[private]
test-coverage_impl:
    pnpm test:coverage

[private]
clean-hard_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    rm -rf .next out dist .nx/cache node_modules
    log_end "Hard clean: removed build artifacts and node_modules"

[private]
nx-graph_impl:
    pnpm nx graph

[private]
nx-affected_impl:
    pnpm nx affected

[private]
nx-clear-cache_impl:
    pnpm nx reset

[private]
quality_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    just lint_impl
    just test_impl
    just typecheck_impl

[private]
doc-search_impl query:
    #!/usr/bin/env bash
    set -euo pipefail
    if command -v qmd >/dev/null 2>&1; then
        qmd search "{{query}}" | head -20
    else
        echo "qmd not found - falling back to ripgrep..."
        rg --type md "{{query}}" docs/ internal-docs/ memory/ || true
    fi

[private]
tasks_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    if command -v tkr >/dev/null 2>&1; then
        tkr list --status=open
    else
        echo "tkr not found"
    fi

[private]
task-ready_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    if command -v tkr >/dev/null 2>&1; then
        tkr ready
    else
        echo "tkr not found"
    fi

[private]
task-start_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    if command -v tkr >/dev/null 2>&1; then
        task_id=$(tkr ready | head -1 | cut -d' ' -f1)
        if [ -n "$task_id" ]; then
            tkr start "$task_id"
            log_info "Started task: $task_id"
        else
            log_info "No available tasks"
        fi
    else
        echo "tkr not found"
    fi

[private]
setup_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    just bootstrap_impl
    # Configure versioned git hooks (submodule-integrity pre-commit check).
    # scripts/hooks/pre-commit prevents submodules from being tracked as
    # trees (040000) instead of gitlinks (160000). See the hook file header
    # for coexistence notes with the pre-commit framework.
    git config core.hooksPath scripts/hooks
    log_end "Git hooks path configured (core.hooksPath=scripts/hooks)"
    log_end "pnpm monorepo development environment ready"

# Dependency synchronization
{% include 'partials.bak/partials/justfile-partials/typescript-deps-sync.jinja' %}

# Help target
help:
    @echo "📦 pnpm Monorepo - Available Commands"
    @echo ""
    @echo "Standard commands:"
    @echo "  just bootstrap    - Initialize the development environment (runs pnpm install)"
    @echo "  just build        - Build all packages and apps"
    @echo "  just test         - Run all tests"
    @echo "  just lint         - Run linting"
    @echo "  just typecheck    - Run type checking"
    @echo "  just dev          - Start all apps in development mode"
    @echo "  just clean        - Clean build artifacts"
    @echo "  just doctor       - Check environment health"
    @echo "  just quality      - Run all quality checks (lint + test + typecheck)"
    @echo "  just prime        - Index documentation and update repository"
    @echo ""
    @echo "Memory & Task Management:"
    @echo "  just doc-search   - Search documentation and memory"
    @echo "  just tasks        - List current tasks"
    @echo "  just task-ready   - Get next available task"
    @echo "  just task-start   - Start working on available task"
    @echo ""
    @echo "pnpm monorepo commands:"
    @echo "  just format       - Format code with prettier"
    @echo "  just lint-fix     - Fix linting issues"
    @echo "  just test-unit    - Run unit tests only"
    @echo "  just test-coverage- Generate coverage reports"
    @echo "  just clean-hard   - Remove build artifacts and node_modules"
    @echo ""
    @echo "Nx commands:"
    @echo "  just nx-graph     - Show Nx project graph"
    @echo "  just nx-affected  - Run affected projects"
    @echo "  just nx-clear-cache - Clear Nx cache"
    @echo ""
    @echo "TypeScript-specific commands:"
    @echo "  just sync-deps    - Sync lock file with package.json"
    @echo "  just pre-commit   - Run pre-commit checks"
    @echo ""
    @echo "Verbosity: set JUST_LOG=1 for all output, JUST_LOG=startend for start/end markers"

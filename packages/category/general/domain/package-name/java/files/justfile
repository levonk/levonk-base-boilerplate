# Justfile for {{ package_name | default('java-package') }} Java Package

_log := '
_jv_has() {
  local cat="$1"
  local v="${JUST_LOG:-0}"
  case "$v" in
    1|all) return 0 ;;
    0|"") return 1 ;;
  esac
  v="${v//startend/start,end}"
  echo ",$v," | grep -q ",$cat,"
}
log_info()   { _jv_has info   && echo "$*" || true; }
log_start()  { _jv_has start  && echo "▶ $*" || true; }
log_end()    { _jv_has end    && echo "✔ $*" || true; }
log_status() { _jv_has status && echo "$*" || true; }
log_warn()   { echo "⚠️  $*" >&2; }
log_error()  { echo "❌ $*" >&2; }
log_startend() {
  local msg="$1"; shift
  local rc
  _jv_has start && echo "▶ $msg" || true
  rc=0; "$@" || rc=$?
  _jv_has end && echo "✔ $msg complete" || true
  return $rc
}
'

# Devbox auto-detection: run impl target directly if in devbox,
# re-exec via devbox run if not, or fail with doctor diagnostic.
_devbox target *args:
    #!/usr/bin/env bash
    {{_log}}
    if [ "${DEVBOX_SHELL_ENABLED:-0}" = "1" ]; then
        exec just "{{target}}" {{args}}
    elif command -v devbox >/dev/null 2>&1; then
        exec devbox run -- just "{{target}}" {{args}}
    else
        log_error "devbox not found in PATH."
        log_warn "Running doctor to diagnose environment issues..."
        just doctor 2>/dev/null || true
        exit 1
    fi

# Default target
default: dev

# Internal targets
[private]
bootstrap_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Bootstrapping {{ package_name | default('java-package') }}"

    # Check Java installation
    if ! command -v java >/dev/null 2>&1; then
        log_error "java not found"
        exit 1
    fi

    # Check Maven installation
    if ! command -v mvn >/dev/null 2>&1; then
        log_error "mvn not found"
        exit 1
    fi

    log_end "Bootstrap complete"

[private]
doctor_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "🔍 Running health checks for {{ package_name | default('java-package') }}..."

    # Check required tools
    echo "Checking tools:"
    command -v java >/dev/null 2>&1 && echo "✅ java" || echo "❌ java missing"
    command -v javac >/dev/null 2>&1 && echo "✅ javac" || echo "❌ javac missing"
    command -v mvn >/dev/null 2>&1 && echo "✅ mvn" || echo "❌ mvn missing"
    command -v just >/dev/null 2>&1 && echo "✅ just" || echo "❌ just missing"

    # Check Java version
    if command -v java >/dev/null 2>&1; then
        echo "Java version: $(java -version 2>&1 | head -n 1)"
    fi

    # Check project structure
    echo "Checking structure:"
    test -f pom.xml && echo "✅ pom.xml" || echo "❌ pom.xml missing"
    test -d src && echo "✅ src directory" || echo "⚠️  src directory missing"
    test -d src/main/java && echo "✅ src/main/java" || echo "⚠️  src/main/java missing"
    test -d src/test/java && echo "✅ src/test/java" || echo "⚠️  src/test/java missing"

    echo "🏁 Doctor complete"

[private]
clean_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Cleaning {{ package_name | default('java-package') }}"

    # Clean Maven artifacts
    mvn clean

    log_end "Clean complete"

[private]
build_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Building {{ package_name | default('java-package') }}"

    # Build the project
    mvn clean compile

    log_end "Build complete"

[private]
dev_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Starting development environment for {{ package_name | default('java-package') }}"

    # Watch for changes and compile
    log_info "Watching for changes... (Ctrl+C to stop)"
    log_info "Available commands:"
    log_info "   just test    - Run tests"
    log_info "   just lint    - Run linting"
    log_info "   just build   - Build project"
    log_info "   just run     - Run application"

    # Simple watch loop
    while true; do
        sleep 5
        # Check if any Java files changed
        if find . -name "*.java" -newer /tmp/last-check 2>/dev/null | grep -q .; then
            touch /tmp/last-check
            log_info "Java files changed, consider rebuilding"
        fi
    done

[private]
test_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Testing {{ package_name | default('java-package') }}"

    # Run tests
    mvn test

    log_end "Tests complete"

[private]
lint_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Linting {{ package_name | default('java-package') }}"

    # Run linting tools
    if mvn spotbugs:check >/dev/null 2>&1; then
        log_info "Running SpotBugs..."
        mvn spotbugs:check || true
    else
        log_warn "SpotBugs not available"
    fi

    if mvn checkstyle:check >/dev/null 2>&1; then
        log_info "Running Checkstyle..."
        mvn checkstyle:check || true
    else
        log_warn "Checkstyle not available"
    fi

    log_end "Linting complete"

[private]
typecheck_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Type checking {{ package_name | default('java-package') }}"

    # Compile for type checking
    mvn clean compile

    log_end "Type checking complete"

# Public targets (user-facing)
bootstrap:
    @just _devbox bootstrap_impl

doctor:
    @just _devbox doctor_impl

clean:
    @just _devbox clean_impl

build:
    @just _devbox build_impl

dev:
    @just _devbox dev_impl

test:
    @just _devbox test_impl

lint:
    @just _devbox lint_impl

typecheck:
    @just _devbox typecheck_impl

# Additional Java-specific targets
build-release:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Building {{ package_name | default('java-package') }} in release mode"

    # Build without tests
    mvn clean package -DskipTests

    log_end "Release build complete"

run:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Running {{ package_name | default('java-package') }}"

    # Run the application
    if [ -f "pom.xml" ]; then
        mvn exec:java
    else
        log_error "No pom.xml found"
        exit 1
    fi

test-coverage:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Running tests with coverage for {{ package_name | default('java-package') }}"

    # Run tests with coverage
    if mvn jacoco:report >/dev/null 2>&1; then
        mvn jacoco:report
        log_info "Coverage report generated: target/site/jacoco/index.html"
    else
        log_warn "JaCoCo not available"
        mvn test
    fi

    log_end "Coverage complete"


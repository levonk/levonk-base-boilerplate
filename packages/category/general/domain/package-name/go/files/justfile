# Justfile for {{ package_name | default('go-package') }} Go Package

_log := '
_jv_has() {
  local cat="$1"
  local v="${JUST_LOG:-0}"
  case "$v" in
    1|all) return 0 ;;
    0|"") return 1 ;;
  esac
  v="${v//startend/start,end}"
  echo ",$v," | grep -q ",$cat,"
}
log_info()   { _jv_has info   && echo "$*" || true; }
log_start()  { _jv_has start  && echo "▶ $*" || true; }
log_end()    { _jv_has end    && echo "✔ $*" || true; }
log_status() { _jv_has status && echo "$*" || true; }
log_warn()   { echo "⚠️  $*" >&2; }
log_error()  { echo "❌ $*" >&2; }
log_startend() {
  local msg="$1"; shift
  local rc
  _jv_has start && echo "▶ $msg" || true
  rc=0; "$@" || rc=$?
  _jv_has end && echo "✔ $msg complete" || true
  return $rc
}
'

# Devbox auto-detection: run impl target directly if in devbox,
# re-exec via devbox run if not, or fail with doctor diagnostic.
_devbox target *args:
    #!/usr/bin/env bash
    {{_log}}
    if [ "${DEVBOX_SHELL_ENABLED:-0}" = "1" ]; then
        exec just "{{target}}" {{args}}
    elif command -v devbox >/dev/null 2>&1; then
        exec devbox run -- just "{{target}}" {{args}}
    else
        log_error "devbox not found in PATH."
        log_warn "Running doctor to diagnose environment issues..."
        just doctor 2>/dev/null || true
        exit 1
    fi

# Default target
default: dev

# Internal targets
[private]
bootstrap_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Bootstrapping {{ package_name | default('go-package') }}"

    # Download dependencies
    go mod download
    go mod tidy

    # Ensure bin directory exists
    mkdir -p bin

    log_end "Bootstrap complete"

[private]
doctor_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "🔍 Running health checks for {{ package_name | default('go-package') }}..."

    # Check required tools
    echo "Checking tools:"
    command -v go >/dev/null 2>&1 && echo "✅ go" || echo "❌ go missing"
    command -v git >/dev/null 2>&1 && echo "✅ git" || echo "❌ git missing"
    command -v just >/dev/null 2>&1 && echo "✅ just" || echo "❌ just missing"

    # Check Go version
    if command -v go >/dev/null 2>&1; then
        echo "Go version: $(go version)"
    fi

    # Check project structure
    echo "Checking structure:"
    test -f go.mod && echo "✅ go.mod" || echo "❌ go.mod missing"
    test -f go.sum && echo "✅ go.sum" || echo "⚠️  go.sum missing (will be created)"
    test -d cmd && echo "✅ cmd directory" || echo "⚠️  cmd directory missing"
    test -d pkg && echo "✅ pkg directory" || echo "⚠️  pkg directory missing"
    test -d internal && echo "✅ internal directory" || echo "⚠️  internal directory missing"

    echo "🏁 Doctor complete"

[private]
clean_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Cleaning {{ package_name | default('go-package') }}"

    # Remove build artifacts
    rm -rf bin/
    rm -f *.exe
    rm -f *.test
    rm -f *.prof

    # Clean cache
    go clean -cache
    go clean -testcache

    log_end "Clean complete"

[private]
build_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Building {{ package_name | default('go-package') }}"

    # Ensure bin directory exists
    mkdir -p bin

    # Build the main application
    if [ -f "main.go" ]; then
        go build -o bin/{{ package_slug | default('app') }} main.go
    elif [ -d "cmd" ]; then
        # Build all commands in cmd directory
        for cmd in cmd/*; do
            if [ -d "$cmd" ]; then
                cmd_name=$(basename "$cmd")
                log_info "Building $cmd_name..."
                go build -o bin/"$cmd_name" "./cmd/$cmd_name"
            fi
        done
    else
        log_warn "No main.go or cmd directory found"
    fi

    log_end "Build complete"

[private]
dev_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Starting development environment for {{ package_name | default('go-package') }}"

    # Watch for changes and run hot reload
    log_info "Watching for changes... (Ctrl+C to stop)"
    log_info "Available commands:"
    log_info "   just test    - Run tests"
    log_info "   just lint    - Run linting"
    log_info "   just build   - Build application"
    log_info "   just run     - Run application"

    # Simple watch loop
    while true; do
        sleep 5
        # Check if any Go files changed
        if find . -name "*.go" -newer /tmp/last-check 2>/dev/null | grep -q .; then
            touch /tmp/last-check
            log_info "Go files changed, consider rebuilding"
        fi
    done

[private]
test_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Testing {{ package_name | default('go-package') }}"

    # Run tests with coverage
    go test -v -cover ./...

    log_end "Tests complete"

[private]
lint_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Linting {{ package_name | default('go-package') }}"

    # Run golangci-lint if available
    if command -v golangci-lint >/dev/null 2>&1; then
        golangci-lint run
    else
        log_warn "golangci-lint not available, running basic checks..."
        # Basic go vet and fmt checks
        go vet ./...
        go fmt ./...
    fi

    log_end "Linting complete"

[private]
typecheck_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Type checking {{ package_name | default('go-package') }}"

    # Run type checking
    go vet ./...

    log_end "Type checking complete"

# Public targets (user-facing)
bootstrap:
    @just _devbox bootstrap_impl

doctor:
    @just _devbox doctor_impl

clean:
    @just _devbox clean_impl

build:
    @just _devbox build_impl

dev:
    @just _devbox dev_impl

test:
    @just _devbox test_impl

lint:
    @just _devbox lint_impl

typecheck:
    @just _devbox typecheck_impl

# Additional Go-specific targets
run:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Running {{ package_name | default('go-package') }}"

    # Run the main application
    if [ -f "bin/{{ package_slug | default('app') }}" ]; then
        ./bin/{{ package_slug | default('app') }}
    elif [ -f "main.go" ]; then
        go run main.go
    elif [ -d "cmd" ]; then
        # Run the first command found
        for cmd in cmd/*; do
            if [ -d "$cmd" ]; then
                cmd_name=$(basename "$cmd")
                log_info "Running $cmd_name..."
                go run "./cmd/$cmd_name"
                break
            fi
        done
    else
        log_error "No executable found"
        exit 1
    fi

test-coverage:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Running tests with coverage for {{ package_name | default('go-package') }}"

    # Create coverage directory
    mkdir -p coverage

    # Run tests with coverage
    go test -cover -coverprofile=coverage/coverage.out ./...

    # Generate HTML coverage report
    if command -v go >/dev/null 2>&1; then
        go tool cover -html=coverage/coverage.out -o coverage/coverage.html
        log_info "Coverage report generated: coverage/coverage.html"
    fi

    log_end "Coverage complete"

benchmark:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Running benchmarks for {{ package_name | default('go-package') }}"

    # Run benchmarks
    go test -bench=. -benchmem ./...

    log_end "Benchmarks complete"

mod-tidy:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Tidying Go modules"

    go mod tidy

    log_end "Modules tidied"

mod-download:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Downloading Go modules"

    go mod download

    log_end "Modules downloaded"

mod-verify:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Verifying Go modules"

    go mod verify

    log_end "Modules verified"

generate:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Generating Go code"

    # Run go generate
    go generate ./...

    log_end "Code generation complete"

validate:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Validating {{ package_name | default('go-package') }}"

    # Run all validation checks
    just typecheck
    just lint
    just test

    log_end "Validation complete"

install:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Installing {{ package_name | default('go-package') }}"

    # Install the binary
    if [ -f "bin/{{ package_slug | default('app') }}" ]; then
        cp bin/{{ package_slug | default('app') }} ~/.local/bin/
        log_end "Installed to ~/.local/bin/"
    else
        log_error "No binary found. Run 'just build' first."
        exit 1
    fi

uninstall:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Uninstalling {{ package_name | default('go-package') }}"

    # Remove the binary
    if [ -f ~/.local/bin/{{ package_slug | default('app') }} ]; then
        rm -f ~/.local/bin/{{ package_slug | default('app') }}
        log_info "Removed from ~/.local/bin/"
    else
        log_warn "Binary not found in ~/.local/bin/"
    fi

    log_end "Uninstallation complete"

# Justfile for {{ package_name | default('rust-package') }} Rust Package

_log := '
_jv_has() {
  local cat="$1"
  local v="${JUST_LOG:-0}"
  case "$v" in
    1|all) return 0 ;;
    0|"") return 1 ;;
  esac
  v="${v//startend/start,end}"
  echo ",$v," | grep -q ",$cat,"
}
log_info()   { _jv_has info   && echo "$*" || true; }
log_start()  { _jv_has start  && echo "▶ $*" || true; }
log_end()    { _jv_has end    && echo "✔ $*" || true; }
log_status() { _jv_has status && echo "$*" || true; }
log_warn()   { echo "⚠️  $*" >&2; }
log_error()  { echo "❌ $*" >&2; }
log_startend() {
  local msg="$1"; shift
  local rc
  _jv_has start && echo "▶ $msg" || true
  rc=0; "$@" || rc=$?
  _jv_has end && echo "✔ $msg complete" || true
  return $rc
}
'

# Devbox auto-detection: run impl target directly if in devbox,
# re-exec via devbox run if not, or fail with doctor diagnostic.
_devbox target *args:
    #!/usr/bin/env bash
    {{_log}}
    if [ "${DEVBOX_SHELL_ENABLED:-0}" = "1" ]; then
        exec just "{{target}}" {{args}}
    elif command -v devbox >/dev/null 2>&1; then
        exec devbox run -- just "{{target}}" {{args}}
    else
        log_error "devbox not found in PATH."
        log_warn "Running doctor to diagnose environment issues..."
        just doctor 2>/dev/null || true
        exit 1
    fi

# Default target
default: dev

# Internal targets
[private]
bootstrap_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Bootstrapping {{ package_name | default('rust-package') }}"

    # Check Rust toolchain
    if ! command -v cargo >/dev/null 2>&1; then
        log_error "cargo not found"
        exit 1
    fi

    # Install rust-analyzer if not available
    if ! command -v rust-analyzer >/dev/null 2>&1; then
        log_warn "rust-analyzer not available"
    fi

    log_end "Bootstrap complete"

[private]
doctor_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "🔍 Running health checks for {{ package_name | default('rust-package') }}..."

    # Check required tools
    echo "Checking tools:"
    command -v rustc >/dev/null 2>&1 && echo "✅ rustc" || echo "❌ rustc missing"
    command -v cargo >/dev/null 2>&1 && echo "✅ cargo" || echo "❌ cargo missing"
    command -v rust-analyzer >/dev/null 2>&1 && echo "✅ rust-analyzer" || echo "⚠️  rust-analyzer missing"
    command -v just >/dev/null 2>&1 && echo "✅ just" || echo "❌ just missing"

    # Check Rust version
    if command -v rustc >/dev/null 2>&1; then
        echo "Rust version: $(rustc --version)"
    fi

    # Check project structure
    echo "Checking structure:"
    test -f Cargo.toml && echo "✅ Cargo.toml" || echo "❌ Cargo.toml missing"
    test -d src && echo "✅ src directory" || echo "❌ src directory missing"
    test -f src/main.rs && echo "✅ src/main.rs" || echo "⚠️  src/main.rs missing (library package)"
    test -f src/lib.rs && echo "✅ src/lib.rs" || echo "⚠️  src/lib.rs missing (binary package)"

    echo "🏁 Doctor complete"

[private]
clean_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Cleaning {{ package_name | default('rust-package') }}"

    # Clean cargo artifacts
    cargo clean

    # Remove additional artifacts
    rm -rf target/
    rm -rf Cargo.lock

    log_end "Clean complete"

[private]
build_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Building {{ package_name | default('rust-package') }}"

    # Build the project
    cargo build

    log_end "Build complete"

[private]
dev_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Starting development environment for {{ package_name | default('rust-package') }}"

    # Watch for changes and run tests
    if command -v cargo-watch >/dev/null 2>&1; then
        cargo watch -x test
    else
        log_info "Watching for changes... (Ctrl+C to stop)"
        log_info "Available commands:"
        log_info "   just test    - Run tests"
        log_info "   just lint    - Run linting"
        log_info "   just build   - Build project"
        log_info "   just run     - Run project"

        # Simple watch loop
        while true; do
            sleep 5
            # Check if any Rust files changed
            if find . -name "*.rs" -newer /tmp/last-check 2>/dev/null | grep -q .; then
                touch /tmp/last-check
                log_info "Rust files changed, consider rebuilding"
            fi
        done
    fi

[private]
test_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Testing {{ package_name | default('rust-package') }}"

    # Run tests
    cargo test

    log_end "Tests complete"

[private]
lint_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Linting {{ package_name | default('rust-package') }}"

    # Run clippy
    if command -v cargo-clippy >/dev/null 2>&1; then
        cargo clippy -- -D warnings
    else
        log_warn "clippy not available"
    fi

    log_end "Linting complete"

[private]
typecheck_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Type checking {{ package_name | default('rust-package') }}"

    # Run cargo check
    cargo check

    log_end "Type checking complete"

# Public targets (user-facing)
bootstrap:
    @just _devbox bootstrap_impl

doctor:
    @just _devbox doctor_impl

clean:
    @just _devbox clean_impl

build:
    @just _devbox build_impl

dev:
    @just _devbox dev_impl

test:
    @just _devbox test_impl

lint:
    @just _devbox lint_impl

typecheck:
    @just _devbox typecheck_impl

release:
    @just _devbox release_impl

# Additional Rust-specific targets
build-release:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Building {{ package_name | default('rust-package') }} in release mode"

    cargo build --release

    log_end "Release build complete"

[private]
release_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Starting release pipeline for {{ package_name | default('rust-package') }}"

    # Run all quality checks and build
    just typecheck_impl
    just lint_impl
    just test_impl
    just build-release

    log_end "Release complete! Binary available at target/release/{{ package_name | default('rust-package') }}"

run:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Running {{ package_name | default('rust-package') }}"

    # Run the project
    if [ -f "src/main.rs" ]; then
        cargo run
    elif [ -f "src/lib.rs" ]; then
        log_warn "This is a library package, no main.rs found"
        log_info "Try: cargo test or cargo run --example <example>"
    else
        log_error "No src/main.rs or src/lib.rs found"
        exit 1
    fi

test-coverage:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Running tests with coverage for {{ package_name | default('rust-package') }}"

    # Run tests with coverage if tarpaulin is available
    if command -v cargo-tarpaulin >/dev/null 2>&1; then
        cargo tarpaulin --out Html
        log_info "Coverage report generated: tarpaulin-report/html/index.html"
    else
        log_warn "cargo-tarpaulin not available"
        log_info "Install with: cargo install cargo-tarpaulin"
        cargo test
    fi

    log_end "Coverage complete"

format:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Formatting {{ package_name | default('rust-package') }}"

    # Format code with rustfmt
    if command -v cargo-fmt >/dev/null 2>&1; then
        cargo fmt
    else
        log_warn "rustfmt not available"
    fi

    log_end "Formatting complete"

format-check:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Checking format for {{ package_name | default('rust-package') }}"

    # Check code format with rustfmt
    if command -v cargo-fmt >/dev/null 2>&1; then
        cargo fmt -- --check
    else
        log_warn "rustfmt not available"
    fi

    log_end "Format check complete"

doc:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Generating documentation for {{ package_name | default('rust-package') }}"

    # Generate documentation
    cargo doc --open

    log_info "Documentation generated and opened"

doc-no-open:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Generating documentation for {{ package_name | default('rust-package') }}"

    # Generate documentation without opening
    cargo doc

    log_info "Documentation generated: target/doc/"

audit:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Auditing dependencies for {{ package_name | default('rust-package') }}"

    # Audit dependencies
    if command -v cargo-audit >/dev/null 2>&1; then
        cargo audit
    else
        log_warn "cargo-audit not available"
        log_info "Install with: cargo install cargo-audit"
    fi

    log_end "Audit complete"

outdated:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Checking for outdated dependencies for {{ package_name | default('rust-package') }}"

    # Show available dependency updates (non-blocking — reports drift only)
    if command -v cargo-outdated >/dev/null 2>&1; then
        cargo outdated --exit-code 0 || log_warn "cargo outdated reported errors (non-blocking)"
    else
        log_warn "cargo-outdated not available"
        log_info "Install with: cargo install cargo-outdated"
    fi

    log_end "Outdated check complete"

publish-dry-run:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Dry run publish for {{ package_name | default('rust-package') }}"

    # Dry run publish
    cargo publish --dry-run

    log_end "Dry run complete"

publish:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Publishing {{ package_name | default('rust-package') }}"

    # Publish to crates.io
    cargo publish

    log_end "Published to crates.io"

check:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Checking {{ package_name | default('rust-package') }}"

    # Run cargo check
    cargo check

    log_end "Check complete"

validate:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Validating {{ package_name | default('rust-package') }}"

    # Run all validation checks
    just format-check
    just lint
    just test
    just doc-no-open
    just audit
    just outdated

    log_end "Validation complete"

bench:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Running benchmarks for {{ package_name | default('rust-package') }}"

    # Run benchmarks
    cargo bench

    log_end "Benchmarks complete"

install:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Installing {{ package_name | default('rust-package') }}"

    # Install the binary
    if [ -f "src/main.rs" ]; then
        cargo install --path .
        log_end "Installed to ~/.cargo/bin/"
    else
        log_warn "This is a library package, no binary to install"
    fi

uninstall:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Uninstalling {{ package_name | default('rust-package') }}"

    # Uninstall the binary
    if [ -f "src/main.rs" ]; then
        cargo uninstall {{ package_name | default('rust-package') }}
        log_info "Uninstalled from ~/.cargo/bin/"
    else
        log_warn "This is a library package, no binary to uninstall"
    fi

    log_end "Uninstallation complete"

{
  "name": "{{module_name}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@*",
  "description": "{{description}}",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "clean:hard": "rm -rf dist node_modules",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:superlint": "docker run --rm -e RUN_LOCAL=true -e GITHUB_TOKEN=dummy -v ${PWD}:/tmp/lint -w /tmp/lint super-linter/super-linter:latest",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "preinstall": "pnpm dlx only-allow pnpm"
  },
  "dependencies": {},
  "devDependencies": {
    "@antfu/ni": "catalog:",
{% if include_workspace_deps %}
    "@job-aide/tools-lint-eslint-config": "workspace:*",
    "@job-aide/tools-playwright-config": "workspace:*",
{% else %}
    "@eslint/js": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
{% endif %}
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "fallow": "catalog:",
    "jiti": "catalog:",
    "only-allow": "catalog:",
    "prettier": "catalog:",
    "skillman": "catalog:",
    "skills-detector": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --cache",
      "prettier --write"
    ],
    "*.{md,json}": "prettier --write"
  },
  "modeline": "vim: set ft=json:"
}

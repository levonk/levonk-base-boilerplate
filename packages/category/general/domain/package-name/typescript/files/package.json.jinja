{
  "name": "{{module_name}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "{{description}}",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "clean:hard": "rm -rf dist node_modules",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:superlint": "docker run --rm -e RUN_LOCAL=true -e GITHUB_TOKEN=dummy -v ${PWD}:/tmp/lint -w /tmp/lint super-linter/super-linter:latest",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "preinstall": "pnpm dlx only-allow pnpm"
  },
  "dependencies": {},
  "devDependencies": {
{% if include_workspace_deps %}
    "@job-aide/tools-lint-eslint-config": "workspace:*",
    "@job-aide/tools-playwright-config": "workspace:*",
{% endif %}
    {% include "partials.bak/partials/package-json-partials/core-typescript-dev-deps.partial.json.jinja" %}
    {% include "partials.bak/partials/package-json-partials/library-typescript-dev-deps.partial.json.jinja" %}
    "@total-typescript/shoehorn": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --cache",
      "prettier --write"
    ],
    "*.{md,json}": "prettier --write"
  },
  {% include "partials.bak/partials/package-json-partials/package-json-tooling.partial.json.jinja" %}
  "modeline": "vim: set ft=json:"
}

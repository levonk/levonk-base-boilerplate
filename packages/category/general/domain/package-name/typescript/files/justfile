# Justfile for {{ package_name | default('typescript-package') }} TypeScript Package

_log := '
_jv_has() {
  local cat="$1"
  local v="${JUST_LOG:-0}"
  case "$v" in
    1|all) return 0 ;;
    0|"") return 1 ;;
  esac
  v="${v//startend/start,end}"
  echo ",$v," | grep -q ",$cat,"
}
log_info()   { _jv_has info   && echo "$*" || true; }
log_start()  { _jv_has start  && echo "▶ $*" || true; }
log_end()    { _jv_has end    && echo "✔ $*" || true; }
log_status() { _jv_has status && echo "$*" || true; }
log_warn()   { echo "⚠️  $*" >&2; }
log_error()  { echo "❌ $*" >&2; }
log_startend() {
  local msg="$1"; shift
  local rc
  _jv_has start && echo "▶ $msg" || true
  rc=0; "$@" || rc=$?
  _jv_has end && echo "✔ $msg complete" || true
  return $rc
}
'

# Devbox auto-detection: run impl target directly if in devbox,
# re-exec via devbox run if not, or fail with doctor diagnostic.
_devbox target *args:
    #!/usr/bin/env bash
    {{_log}}
    if [ "${DEVBOX_SHELL_ENABLED:-0}" = "1" ]; then
        exec just "{{target}}" {{args}}
    elif command -v devbox >/dev/null 2>&1; then
        exec devbox run -- just "{{target}}" {{args}}
    else
        log_error "devbox not found in PATH."
        log_warn "Running doctor to diagnose environment issues..."
        just doctor 2>/dev/null || true
        exit 1
    fi

# Default target
default: dev

# Internal targets
[private]
bootstrap_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Bootstrapping {{ package_name | default('typescript-package') }}"

    # Install dependencies
    if [ -f "package.json" ]; then
        pnpm install
    else
        log_warn "No package.json found"
    fi

    log_end "Bootstrap complete"

[private]
doctor_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "🔍 Running health checks for {{ package_name | default('typescript-package') }}..."

    # Check required tools
    echo "Checking tools:"
    command -v node >/dev/null 2>&1 && echo "✅ node" || echo "❌ node missing"
    command -v pnpm >/dev/null 2>&1 && echo "✅ pnpm" || echo "❌ pnpm missing"
    command -v just >/dev/null 2>&1 && echo "✅ just" || echo "❌ just missing"

    # Check Node.js version
    if command -v node >/dev/null 2>&1; then
        echo "Node.js version: $(node --version)"
    fi

    # Check TypeScript
    if command -v tsc >/dev/null 2>&1; then
        echo "TypeScript version: $(tsc --version)"
    fi

    # Check project structure
    echo "Checking structure:"
    test -f package.json && echo "✅ package.json" || echo "❌ package.json missing"
    test -f tsconfig.json && echo "✅ tsconfig.json" || echo "⚠️  tsconfig.json missing"
    test -d src && echo "✅ src directory" || echo "⚠️  src directory missing"
    test -d tests && echo "✅ tests directory" || echo "⚠️  tests directory missing"

    echo "🏁 Doctor complete"

[private]
clean_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Cleaning {{ package_name | default('typescript-package') }}"

    # Remove build artifacts
    rm -rf dist/
    rm -rf build/
    rm -rf .nyc_output/
    rm -rf coverage/
    rm -rf .turbo/
    rm -rf .next/

    # Remove cache files
    rm -rf node_modules/.cache
    rm -rf .eslintcache
    rm -f *.tsbuildinfo

    # Clean pnpm
    if command -v pnpm >/dev/null 2>&1; then
        pnpm store prune || true
    fi

    log_end "Clean complete"

[private]
build_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Building {{ package_name | default('typescript-package') }}"

    # Build the project
    if [ -f "package.json" ]; then
        pnpm build
    else
        log_warn "No package.json found"
        exit 1
    fi

    log_end "Build complete"

[private]
dev_impl:

# Justfile for {{ package_name | default('python-package') }} Python Package

_log := '
_jv_has() {
  local cat="$1"
  local v="${JUST_LOG:-0}"
  case "$v" in
    1|all) return 0 ;;
    0|"") return 1 ;;
  esac
  v="${v//startend/start,end}"
  echo ",$v," | grep -q ",$cat,"
}
log_info()   { _jv_has info   && echo "$*" || true; }
log_start()  { _jv_has start  && echo "▶ $*" || true; }
log_end()    { _jv_has end    && echo "✔ $*" || true; }
log_status() { _jv_has status && echo "$*" || true; }
log_warn()   { echo "⚠️  $*" >&2; }
log_error()  { echo "❌ $*" >&2; }
log_startend() {
  local msg="$1"; shift
  local rc
  _jv_has start && echo "▶ $msg" || true
  rc=0; "$@" || rc=$?
  _jv_has end && echo "✔ $msg complete" || true
  return $rc
}
'

# Devbox auto-detection: run impl target directly if in devbox,
# re-exec via devbox run if not, or fail with doctor diagnostic.
_devbox target *args:
    #!/usr/bin/env bash
    {{_log}}
    if [ "${DEVBOX_SHELL_ENABLED:-0}" = "1" ]; then
        exec just "{{target}}" {{args}}
    elif command -v devbox >/dev/null 2>&1; then
        exec devbox run -- just "{{target}}" {{args}}
    else
        log_error "devbox not found in PATH."
        log_warn "Running doctor to diagnose environment issues..."
        just doctor 2>/dev/null || true
        exit 1
    fi

# Default target
default: dev

# Internal targets
[private]
bootstrap_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Bootstrapping {{ package_name | default('python-package') }}"

    # Install package in development mode
    pip install -e .

    # Install development dependencies
    if [ -f "pyproject.toml" ]; then
        pip install -e ".[dev]"
    fi

    log_end "Bootstrap complete"

[private]
doctor_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "🔍 Running health checks for {{ package_name | default('python-package') }}..."

    # Check required tools
    echo "Checking tools:"
    command -v python >/dev/null 2>&1 && echo "✅ python" || echo "❌ python missing"
    command -v pip >/dev/null 2>&1 && echo "✅ pip" || echo "❌ pip missing"
    command -v poetry >/dev/null 2>&1 && echo "✅ poetry" || echo "⚠️  poetry missing"
    command -v just >/dev/null 2>&1 && echo "✅ just" || echo "❌ just missing"

    # Check Python version
    if command -v python >/dev/null 2>&1; then
        echo "Python version: $(python --version)"
    fi

    # Check project structure
    echo "Checking structure:"
    test -f pyproject.toml && echo "✅ pyproject.toml" || echo "⚠️  pyproject.toml missing"
    test -f setup.py && echo "✅ setup.py" || echo "⚠️  setup.py missing"
    test -d src && echo "✅ src directory" || echo "⚠️  src directory missing"
    test -d tests && echo "✅ tests directory" || echo "⚠️  tests directory missing"

    echo "🏁 Doctor complete"

[private]
clean_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Cleaning {{ package_name | default('python-package') }}"

    # Remove build artifacts
    rm -rf build/
    rm -rf dist/
    rm -rf *.egg-info/
    rm -rf .pytest_cache/
    rm -rf .coverage
    rm -rf htmlcov/
    rm -rf .mypy_cache/
    rm -rf .tox/

    # Remove cache files
    find . -name "*.pyc" -delete
    find . -name "*.pyo" -delete
    find . -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true

    log_end "Clean complete"

[private]
build_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Building {{ package_name | default('python-package') }}"

    # Build the package
    python -m build

    log_end "Build complete"

[private]
dev_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Starting development environment for {{ package_name | default('python-package') }}"

    # Watch for changes and run tests
    log_info "Watching for changes... (Ctrl+C to stop)"
    log_info "Available commands:"
    log_info "   just test    - Run tests"
    log_info "   just lint    - Run linting"
    log_info "   just format  - Format code"
    log_info "   just install - Install package"

    # Simple watch loop
    while true; do
        sleep 5
        # Check if any Python files changed
        if find . -name "*.py" -newer /tmp/last-check 2>/dev/null | grep -q .; then
            touch /tmp/last-check
            log_info "Python files changed, consider running tests"
        fi
    done

[private]
test_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Testing {{ package_name | default('python-package') }}"

    # Run pytest
    if command -v pytest >/dev/null 2>&1; then
        pytest
    else
        python -m pytest
    fi

    log_end "Tests complete"

[private]
lint_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Linting {{ package_name | default('python-package') }}"

    # Run linting tools
    if command -v flake8 >/dev/null 2>&1; then
        log_info "Running flake8..."
        flake8 src tests || true
    else
        log_warn "flake8 not available"
    fi

    if command -v black >/dev/null 2>&1; then
        log_info "Running black --check..."
        black --check src tests || true
    else
        log_warn "black not available"
    fi

    if command -v isort >/dev/null 2>&1; then
        log_info "Running isort --check-only..."
        isort --check-only src tests || true
    else
        log_warn "isort not available"
    fi

    log_end "Linting complete"

[private]
typecheck_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Type checking {{ package_name | default('python-package') }}"

    # Run mypy
    if command -v mypy >/dev/null 2>&1; then
        mypy src
    else
        log_warn "mypy not available"
    fi

    log_end "Type checking complete"

# Public targets (user-facing)
bootstrap:
    @just _devbox bootstrap_impl

doctor:
    @just _devbox doctor_impl

clean:
    @just _devbox clean_impl

build:
    @just _devbox build_impl

dev:
    @just _devbox dev_impl

test:
    @just _devbox test_impl

lint:
    @just _devbox lint_impl

typecheck:
    @just _devbox typecheck_impl

# Additional Python-specific targets
install:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Installing {{ package_name | default('python-package') }}"

    # Install package in development mode
    pip install -e .

    log_end "Installation complete"

install-dev:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Installing {{ package_name | default('python-package') }} with dev dependencies"

    # Install package with development dependencies
    if [ -f "pyproject.toml" ]; then
        pip install -e ".[dev]"
    else
        pip install -e .
        log_warn "No [dev] dependencies found in pyproject.toml"
    fi

    log_end "Development installation complete"

test-coverage:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Running tests with coverage for {{ package_name | default('python-package') }}"

    # Run tests with coverage
    if command -v pytest >/dev/null 2>&1; then
        pytest --cov={{ package_name | default('python-package') }} --cov-report=html
    else
        python -m pytest --cov={{ package_name | default('python-package') }} --cov-report=html
    fi

    log_info "Coverage report generated: htmlcov/index.html"
    log_end "Coverage complete"

test-watch:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Watching tests for {{ package_name | default('python-package') }}"

    # Run pytest-watch if available
    if command -v ptw >/dev/null 2>&1; then
        ptw --runner "python -m pytest"
    else
        log_warn "pytest-watch not available"
        log_info "Install with: pip install pytest-watch"
    fi

format:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Formatting {{ package_name | default('python-package') }}"

    # Format code with black and isort
    if command -v black >/dev/null 2>&1; then
        log_info "Running black..."
        black src tests
    else
        log_warn "black not available"
    fi

    if command -v isort >/dev/null 2>&1; then
        log_info "Running isort..."
        isort src tests
    else
        log_warn "isort not available"
    fi

    log_end "Formatting complete"

docs:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Serving documentation for {{ package_name | default('python-package') }}"

    # Serve documentation with mkdocs if available
    if command -v mkdocs >/dev/null 2>&1; then
        mkdocs serve
    else
        log_warn "mkdocs not available"
        log_info "Install with: pip install mkdocs"
    fi

docs-build:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Building documentation for {{ package_name | default('python-package') }}"

    # Build documentation with mkdocs if available
    if command -v mkdocs >/dev/null 2>&1; then
        mkdocs build
        log_info "Documentation built: site/"
    else
        log_warn "mkdocs not available"
        log_info "Install with: pip install mkdocs"
    fi

publish:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Publishing {{ package_name | default('python-package') }}"

    # Build and publish to PyPI
    just build

    if command -v twine >/dev/null 2>&1; then
        twine upload dist/*
    else
        log_error "twine not available"
        log_info "Install with: pip install twine"
        exit 1
    fi

    log_end "Published to PyPI"

publish-test:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Publishing {{ package_name | default('python-package') }} to test PyPI"

    # Build and publish to test PyPI
    just build

    if command -v twine >/dev/null 2>&1; then
        twine upload --repository testpypi dist/*
    else
        log_error "twine not available"
        log_info "Install with: pip install twine"
        exit 1
    fi

    log_end "Published to test PyPI"

validate:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Validating {{ package_name | default('python-package') }}"

    # Run all validation checks
    just typecheck
    just lint
    just test

    log_end "Validation complete"

{
  "name": "{{ project_slug }}",
  "version": "1.0.0",
  "description": "{{ description }} - A production-ready TypeScript CLI tool following CLI Tool Standards ADR compliance",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "{{ project_slug }}": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "lint": "eslint src/**/*.ts",
    "preinstall": "pnpm dlx only-allow pnpm"
  },
  "keywords": [
    "cli",
    "typescript",
    "command-line",
    "tool",
    "automation"
  ],
  "author": "{{ author_name }}",
  "license": "{{ license }}",
  "homepage": "{{ homepage }}",
  "repository": {
    "type": "git",
    "url": "{{ repository_url }}"
  },
  "bugs": {
    "url": "{{ issues_url }}"
  },
  "dependencies": {
    "@iarna/toml": "catalog:",
    "chalk": "catalog:",
    "cli-progress": "catalog:",
    "commander": "catalog:",
    "glob": "catalog:",
    "ink": "catalog:",
    "ink-select-input": "catalog:",
    "ink-text-input": "catalog:",
    "react": "catalog:",
    "supports-color": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/cli-progress": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "*"
  }
}

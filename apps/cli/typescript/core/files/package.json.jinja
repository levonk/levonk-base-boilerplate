{
  "name": "{{ project_slug }}",
  "version": "1.0.0",
  "description": "{{ description }} - A production-ready TypeScript CLI tool following CLI Tool Standards ADR compliance",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "{{ project_slug }}": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "lint": "eslint src/**/*.ts",
    "preinstall": "pnpm dlx only-allow pnpm"
  },
  "keywords": [
    "cli",
    "typescript",
    "command-line",
    "tool",
    "automation"
  ],
  "author": "{{ author_name }}",
  "license": "{{ license }}",
  "homepage": "{{ homepage }}",
  "repository": {
    "type": "git",
    "url": "{{ repository_url }}"
  },
  "bugs": {
    "url": "{{ issues_url }}"
  },
  "dependencies": {
    "@iarna/toml": "catalog:",
    "chalk": "catalog:",
    "cli-progress": "catalog:",
    "commander": "catalog:",
    "glob": "catalog:",
    "ink": "catalog:",
    "ink-select-input": "catalog:",
    "ink-text-input": "catalog:",
    "react": "catalog:",
    "supports-color": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    {% include "partials.bak/partials/package-json-partials/core-typescript-dev-deps.partial.json.jinja" %}
    {% include "partials.bak/partials/package-json-partials/cli-typescript-dev-deps.partial.json.jinja" %}
    "only-allow": "catalog:"
  },
  {% include "partials.bak/partials/package-json-partials/package-json-tooling.partial.json.jinja" %}
  "modeline": "/* vim: set ft=json: */"
}

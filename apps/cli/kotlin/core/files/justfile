# {{ project_name | default('kotlin-cli-app') }} - Kotlin CLI Development Commands
# Standard justfile following ADR-20260131001

_log := '
_jv_has() {
  local cat="$1"
  local v="${JUST_LOG:-0}"
  case "$v" in
    1|all) return 0 ;;
    0|"") return 1 ;;
  esac
  v="${v//startend/start,end}"
  echo ",$v," | grep -q ",$cat,"
}
log_info()   { _jv_has info   && echo "$*" || true; }
log_start()  { _jv_has start  && echo "▶ $*" || true; }
log_end()    { _jv_has end    && echo "✔ $*" || true; }
log_status() { _jv_has status && echo "$*" || true; }
log_warn()   { echo "⚠️  $*" >&2; }
log_error()  { echo "❌ $*" >&2; }
log_startend() {
  local msg="$1"; shift
  local rc
  _jv_has start && echo "▶ $msg" || true
  rc=0; "$@" || rc=$?
  _jv_has end && echo "✔ $msg complete" || true
  return $rc
}
'

# Devbox auto-detection: run impl target directly if in devbox,
# re-exec via devbox run if not, or fail with doctor diagnostic.
_devbox target *args:
    #!/usr/bin/env bash
    {{_log}}
    if [ "${DEVBOX_SHELL_ENABLED:-0}" = "1" ]; then
        exec just "{{target}}" {{args}}
    elif command -v devbox >/dev/null 2>&1; then
        exec devbox run -- just "{{target}}" {{args}}
    else
        log_error "devbox not found in PATH."
        log_warn "Running doctor to diagnose environment issues..."
        just doctor 2>/dev/null || true
        exit 1
    fi

# Default recipe
default:
    @just --list

# Normal targets - Developer interface (REQUIRED)
clean:
    @just _devbox clean_impl

dev:
    @just _devbox dev_impl

build:
    @just _devbox build_impl

test:
    @just _devbox test_impl

lint:
    @just _devbox lint_impl

typecheck:
    @just _devbox typecheck_impl

release:
    @just _devbox release_impl

# Bootstrap recipes (REQUIRED)
bootstrap:
    @just _devbox bootstrap_impl

[private]
bootstrap_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Install dependencies and initialize memory management
    log_end "Kotlin CLI bootstrap complete for {{ project_name | default('kotlin-cli-app') }}"

    # Initialize tkr for task management
    if command -v tkr >/dev/null 2>&1; then
      if [ ! -d ".tickets" ]; then
        log_info "Initializing tkr..."
        tkr init || log_warn "tkr init failed"
      else
        log_info "tkr already initialized"
      fi
    fi

    # Create memory directory structure for Obsidian
    log_info "Setting up memory structure..."
    mkdir -p memory/{00-inbox,01-projects,02-decisions,03-patterns,04-learnings,05-references,98-logs,99-daily}

    # Create Obsidian configuration if needed
    if [ ! -d ".obsidian" ]; then
      mkdir -p .obsidian
      echo "# Obsidian configuration" > .obsidian/config.md
    fi

# Prime recipes (REQUIRED)
prime:
    @just _devbox prime_impl

[private]
prime_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Update repository and index documentation
    log_info "Updating repository..."
    git fetch || log_warn "git fetch failed (check remote connectivity)"

    # qmd memory indexing
    if command -v qmd >/dev/null 2>&1; then
        log_info "Indexing documentation with qmd..."
        qmd index docs/ internal-docs/ memory/ README.md || log_warn "qmd indexing failed"
        log_info "qmd indexing complete."
    else
        log_info "Skipping qmd (not installed)"
    fi

    log_end "Kotlin CLI priming complete"

# Health and diagnostics (REQUIRED)
doctor:
    @just _devbox doctor_impl

[private]
doctor_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    # Check Kotlin CLI environment
    echo "🔍 Checking {{ project_name | default('kotlin-cli-app') }} development environment..."
    if ! gradle --version >/dev/null 2>&1; then
        echo "❌ Error: gradle not found" >&2
        echo "💡 Suggestion: Ensure Gradle is installed" >&2
        exit 1
    fi
    if ! just --version >/dev/null 2>&1; then
        echo "❌ Error: just not found" >&2
        echo "💡 Suggestion: Ensure just is installed" >&2
        exit 1
    fi
    if [ ! -f build.gradle.kts ]; then
        echo "❌ Error: build.gradle.kts not found (expected in project root)" >&2
        exit 1
    fi
    echo "✅ OK: Gradle + just + build.gradle.kts present"

    # Check for memory management tools
    if command -v qmd >/dev/null 2>&1; then
        echo "✅ OK: qmd available for memory search"
    else
        echo "⚠️  WARNING: qmd not found (install with: cargo install qmd)"
    fi

    if command -v tkr >/dev/null 2>&1; then
        echo "✅ OK: tkr available for task management"
    else
        echo "⚠️  WARNING: tkr not found (install from: https://github.com/levonk/tkr)"
    fi

    # Check for memory structure
    if [ -d memory ]; then
        echo "✅ OK: memory/ directory found"
    else
        echo "⚠️  WARNING: memory/ directory missing (run 'just bootstrap' to create)"
    fi

    echo "🚀 Ready to develop {{ project_name | default('kotlin-cli-app') }}!"

# Quality checks (OPTIONAL but RECOMMENDED)
quality:
    @just _devbox quality_impl

[private]
quality_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    just lint_impl
    just test_impl
    just typecheck_impl

# Memory and task management targets (NEW)
doc-search:
    @just _devbox doc-search_impl

[private]
doc-search_impl query=".":
    #!/usr/bin/env bash
    set -euo pipefail
    # Search memory and documentation with qmd
    if command -v qmd >/dev/null 2>&1; then
        qmd search "{{query}}" | head -20
    else
        echo "qmd not found - falling back to ripgrep..."
        rg --type md "{{query}}" docs/ internal-docs/ memory/ || true
    fi

tasks:
    @just _devbox tasks_impl

[private]
tasks_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    # List current tasks
    if command -v tkr >/dev/null 2>&1; then
        tkr list --status=open
    else
        echo "tkr not found"
    fi

task-ready:
    @just _devbox task-ready_impl

[private]
task-ready_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Get next available task
    if command -v tkr >/dev/null 2>&1; then
        tkr ready
    else
        log_warn "tkr not found"
    fi

task-start:
    @just _devbox task-start_impl

[private]
task-start_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Start working on available task
    if command -v tkr >/dev/null 2>&1; then
        task_id=$(tkr ready | head -1 | cut -d' ' -f1)
        if [ -n "$task_id" ]; then
            tkr start "$task_id"
            log_info "Started task: $task_id"
        else
            log_info "No available tasks"
        fi
    else
        log_warn "tkr not found"
    fi

# Language-specific commands for Kotlin CLI
# Development setup (OPTIONAL)
setup:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_end "Kotlin CLI development environment ready"

# Internal targets - Actual implementation
[private]
clean_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Clean build artifacts
    gradle clean
    log_end "Build artifacts removed"

[private]
build_impl:
    # Build the project in debug mode
    gradle build

[private]
release_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Full release pipeline: quality checks + build
    log_start "Starting release pipeline for {{ project_name | default('kotlin-cli-app') }}"
    just lint_impl
    just test_impl
    just typecheck_impl
    just build-release_impl
    log_end "Release complete! JAR available at build/libs/{{ project_slug }}-0.1.0.jar"

[private]
build-release_impl:
    # Build the project in release mode
    gradle build -x test

[private]
debug_impl:
    # Build the project in debug mode
    gradle build

[private]
install_impl:
    # Install the binary locally
    gradle installDist

[private]
lint_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Lint the code using detekt if available, otherwise skip
    if gradle tasks | grep -q detekt; then
        gradle detekt
    else
        log_warn "detekt not configured, skipping lint"
    fi

[private]
test_impl:
    # Run tests
    gradle test

[private]
typecheck_impl:
    # Run type checking (gradle compileKotlin)
    gradle compileKotlin

[private]
dev_impl:
    # Run the application in development mode
    gradle run

[private]
run_impl *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Run the application with arguments
    gradle run --args="{{args}}"

# Additional Kotlin-specific targets
[private]
format_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Format code with ktlint if available
    if gradle tasks | grep -q ktlintFormat; then
        gradle ktlintFormat
    else
        log_warn "ktlint not configured, skipping format"
    fi

[private]
format-check_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Check code format
    if gradle tasks | grep -q ktlintCheck; then
        gradle ktlintCheck
    else
        log_warn "ktlint not configured, skipping format check"
    fi

[private]
doc_impl:
    # Generate documentation
    gradle dokka

# Help target

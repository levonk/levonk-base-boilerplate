# Python CLI Development Commands

_log := '
_jv_has() {
  local cat="$1"
  local v="${JUST_LOG:-0}"
  case "$v" in
    1|all) return 0 ;;
    0|"") return 1 ;;
  esac
  v="${v//startend/start,end}"
  echo ",$v," | grep -q ",$cat,"
}
log_info()   { _jv_has info   && echo "$*" || true; }
log_start()  { _jv_has start  && echo "▶ $*" || true; }
log_end()    { _jv_has end    && echo "✔ $*" || true; }
log_status() { _jv_has status && echo "$*" || true; }
log_warn()   { echo "⚠️  $*" >&2; }
log_error()  { echo "❌ $*" >&2; }
log_startend() {
  local msg="$1"; shift
  local rc
  _jv_has start && echo "▶ $msg" || true
  rc=0; "$@" || rc=$?
  _jv_has end && echo "✔ $msg complete" || true
  return $rc
}
'

# Devbox auto-detection: run impl target directly if in devbox,
# re-exec via devbox run if not, or fail with doctor diagnostic.
_devbox target *args:
    #!/usr/bin/env bash
    {{_log}}
    if [ "${DEVBOX_SHELL_ENABLED:-0}" = "1" ]; then
        exec just "{{target}}" {{args}}
    elif command -v devbox >/dev/null 2>&1; then
        exec devbox run -- just "{{target}}" {{args}}
    else
        log_error "devbox not found in PATH."
        log_warn "Running doctor to diagnose environment issues..."
        just doctor 2>/dev/null || true
        exit 1
    fi

# Default recipe
default:
    @just --list

# Standard development recipes (REQUIRED)
clean:
    @just _devbox clean_impl

dev:
    @just _devbox dev_impl

build:
    @just _devbox build_impl

test:
    @just _devbox test_impl

lint:
    @just _devbox lint_impl

typecheck:
    @just _devbox typecheck_impl

# Bootstrap recipes (REQUIRED)
bootstrap:
    @just _devbox bootstrap_impl

[private]
bootstrap_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    uv sync
    log_end "Python CLI bootstrap complete"

# Health and diagnostics (REQUIRED)
doctor:
    # Check Python CLI environment
    @echo "🐍 Python version:"
    @python --version
    @echo ""
    @echo "📦 Dependencies:"
    @uv list
    @echo ""
    @echo "🔧 Development tools:"
    @command -v ruff || echo "ruff not found"
    @command -v pytest || echo "pytest not found"
    @command -v mypy || echo "mypy not found"
    @echo ""
    @echo "✅ Python CLI environment is ready!"

# Internal targets - Actual implementation
[private]
clean_impl:
    rm -rf .pytest_cache .coverage htmlcov dist build

[private]
dev_impl:
    {% if include_development %}
    export PYTHONPATH="{{ pythonpath_dev }}"
    {% endif %}
    uv run python -m {{ project_slug }}

[private]
build_impl:
    uv build

[private]
test_impl:
    pytest

[private]
lint_impl:
    uv run ruff check .
    uv run ruff format --check .

[private]
typecheck_impl:
    uv run mypy .

# Development mode
run-dev:
    {% if include_development %}
    export PYTHONPATH="{{ pythonpath_dev }}"
    {% endif %}
    uv run python -m {{ project_slug }}

# Install dependencies
install:
    uv sync

# Run tests
test-cli:
    pytest

# Run tests with coverage
test-coverage:
    uv run pytest --cov={{ project_slug }} --cov-report=html

# Lint code
lint-cli:
    uv run ruff check .
    uv run ruff format --check .

# Format code
format:
    uv run ruff format .

# Type checking
typecheck-cli:
    uv run mypy .

# Build for distribution
build-cli:
    uv build

# Clean up
clean-cli:
    rm -rf .pytest_cache .coverage htmlcov dist build

# Development setup
setup:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    just bootstrap
    log_end "Python CLI development environment ready"

    {% endif %}
    uv run python -m {{ project_slug }}

# Package for distribution
package:
    @just build
    @just clean
    mkdir -p dist
    cp -r build/* dist/

# Health check
health:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_end "Python CLI environment is ready"

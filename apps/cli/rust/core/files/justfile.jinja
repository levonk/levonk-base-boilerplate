# {{ project_name | default('rust-cli-app') }} - Rust CLI Development Commands
# Standard justfile following ADR-20260131001

{% include "partials.bak/partials/justfile-partials/logging.jinja" %}

# Devbox auto-detection: run impl target directly if in devbox,
# re-exec via devbox run if not, or fail with doctor diagnostic.
_devbox target *args:
    #!/usr/bin/env bash
    {{_log}}
    if [ "${DEVBOX_SHELL_ENABLED:-0}" = "1" ]; then
        exec just "{{target}}" {{args}}
    elif command -v devbox >/dev/null 2>&1; then
        exec devbox run -- just "{{target}}" {{args}}
    else
        log_error "devbox not found in PATH."
        log_warn "Running doctor to diagnose environment issues..."
        just doctor 2>/dev/null || true
        exit 1
    fi

# Default recipe
default:
    @just --list

# Normal targets - Developer interface (REQUIRED)
clean:
    @just _devbox clean_impl

dev:
    @just _devbox dev_impl

build:
    @just _devbox build_impl

test:
    @just _devbox test_impl

lint:
    @just _devbox lint_impl

typecheck:
    @just _devbox typecheck_impl

release:
    @just _devbox release_impl

audit:
    @just _devbox audit_impl

outdated:
    @just _devbox outdated_impl

# Bootstrap recipes (REQUIRED)
bootstrap:
    @just _devbox bootstrap_impl

[private]
bootstrap_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Install dependencies and initialize memory management
    log_end "Rust CLI bootstrap complete for {{ project_name | default('rust-cli-app') }}"

    # Initialize tkr for task management
    if command -v tkr >/dev/null 2>&1; then
        if [ ! -d ".tickets" ]; then
            log_info "Initializing tkr..."
            tkr init || log_warn "tkr init failed"
        else
            log_info "tkr already initialized"
        fi
    fi

    # Create memory directory structure for Obsidian
    log_info "Setting up memory structure..."
    mkdir -p memory/{00-inbox,01-projects,02-decisions,03-patterns,04-learnings,05-references,98-logs,99-daily}

    # Create Obsidian configuration if needed
    if [ ! -d ".obsidian" ]; then
        mkdir -p .obsidian
        echo "# Obsidian configuration" > .obsidian/config.md
    fi

# Prime recipes (REQUIRED)
prime:
    @just _devbox prime_impl

[private]
prime_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Update repository and index documentation
    log_info "Updating repository..."
    git fetch || log_warn "git fetch failed (check remote connectivity)"

    # qmd memory indexing
    if command -v qmd >/dev/null 2>&1; then
        log_info "Indexing documentation with qmd..."
        qmd index docs/ internal-docs/ memory/ README.md || log_warn "qmd indexing failed"
        log_info "qmd indexing complete."
    else
        log_info "Skipping qmd (not installed)"
    fi

    log_end "Rust CLI priming complete"

# Health and diagnostics (REQUIRED)
doctor:
    @just _devbox doctor_impl

[private]
doctor_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    # Check Rust CLI environment
    echo "🔍 Checking {{ project_name | default('rust-cli-app') }} development environment..."
    if ! cargo --version >/dev/null 2>&1; then
        echo "❌ Error: cargo not found" >&2
        echo "💡 Suggestion: Ensure Rust toolchain is installed" >&2
        exit 1
    fi
    if ! just --version >/dev/null 2>&1; then
        echo "❌ Error: just not found" >&2
        echo "💡 Suggestion: Ensure just is installed" >&2
        exit 1
    fi
    if [ ! -f Cargo.toml ]; then
        echo "❌ Error: Cargo.toml not found (expected in project root)" >&2
        exit 1
    fi
    echo "✅ OK: Rust toolchain + just + Cargo.toml present"

    # Check for memory management tools
    if command -v qmd >/dev/null 2>&1; then
        echo "✅ OK: qmd available for memory search"
    else
        echo "⚠️  WARNING: qmd not found (install with: cargo install qmd)"
    fi

    if command -v tkr >/dev/null 2>&1; then
        echo "✅ OK: tkr available for task management"
    else
        echo "⚠️  WARNING: tkr not found (install from: https://github.com/levonk/tkr)"
    fi

    # Check for memory structure
    if [ -d memory ]; then
        echo "✅ OK: memory/ directory found"
    else
        echo "⚠️  WARNING: memory/ directory missing (run 'just bootstrap' to create)"
    fi

    echo "🚀 Ready to develop {{ project_name | default('rust-cli-app') }}!"

# Quality checks (OPTIONAL but RECOMMENDED)
quality:
    @just _devbox quality_impl

[private]
quality_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    just lint_impl
    just test_impl
    just typecheck_impl
    just audit_impl

# Memory and task management targets (NEW)
doc-search:
    @just _devbox doc-search_impl

[private]
doc-search_impl query=".":
    #!/usr/bin/env bash
    set -euo pipefail
    # Search memory and documentation with qmd
    if command -v qmd >/dev/null 2>&1; then
        qmd search "{{query}}" | head -20
    else
        echo "qmd not found - falling back to ripgrep..."
        rg --type md "{{query}}" docs/ internal-docs/ memory/ || true
    fi

tasks:
    @just _devbox tasks_impl

[private]
tasks_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    # List current tasks
    if command -v tkr >/dev/null 2>&1; then
        tkr list --status=open
    else
        echo "tkr not found"
    fi

task-ready:
    @just _devbox task-ready_impl

[private]
task-ready_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Get next available task
    if command -v tkr >/dev/null 2>&1; then
        tkr ready
    else
        log_warn "tkr not found"
    fi

task-start:
    @just _devbox task-start_impl

[private]
task-start_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Start working on available task
    if command -v tkr >/dev/null 2>&1; then
        task_id=$(tkr ready | head -1 | cut -d' ' -f1)
        if [ -n "$task_id" ]; then
            tkr start "$task_id"
            log_info "Started task: $task_id"
        else
            log_info "No available tasks"
        fi
    else
        log_warn "tkr not found"
    fi

# Language-specific commands for Rust CLI
# Development setup (OPTIONAL)
setup:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_end "Rust CLI development environment ready"

# Internal targets - Actual implementation
[private]
clean_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Clean build artifacts
    cargo clean
    log_end "Build artifacts removed"

[private]
build_impl:
    # Build the project in debug mode
    cargo build

[private]
release_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Full release pipeline: quality checks + build
    log_start "Starting release pipeline for {{ project_name | default('rust-cli-app') }}"
    just lint_impl
    just test_impl
    just typecheck_impl
    just audit_impl
    just build-release_impl
    log_end "Release complete! Binary available at target/release/{{ project_slug }}"

[private]
build-release_impl:
    # Build the project in release mode
    cargo build --release

[private]
debug_impl:
    # Build the project in debug mode
    cargo build

[private]
install_impl:
    # Install the binary locally
    cargo install --path .

[private]
lint_impl:
    # Lint the code using clippy
    cargo clippy -- -D warnings

[private]
test_impl:
    # Run tests
    cargo test

[private]
typecheck_impl:
    # Run type checking (cargo check)
    cargo check

[private]
dev_impl:
    # Run the application in development mode
    cargo run

[private]
run_impl:
    # Run the application with arguments
    cargo run

{% if include_http_server -%}
serve:
    @just _devbox serve_impl

[private]
serve_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Start the HTTP server
    PORT="${HTTP_PORT:-{{ http_port }}}"
    HOST="${HTTP_HOST:-0.0.0.0}"
    log_info "Starting server on $HOST:$PORT"
    cargo run -- serve --port "$PORT" --host "$HOST"
{% endif -%}

# Additional Rust-specific targets
[private]
test-coverage_impl:
    # Run tests with coverage
    cargo tarpaulin --out Html

[private]
format_impl:
    # Format code with rustfmt
    cargo fmt

[private]
format-check_impl:
    # Check code format
    cargo fmt -- --check

[private]
doc_impl:
    # Generate documentation
    cargo doc --open

[private]
audit_impl:
    # Audit dependencies
    cargo audit

[private]
outdated_impl:
    # Show available dependency updates without making changes
    cargo update --dry-run

# Dependency synchronization
{% include 'partials.bak/partials/justfile-partials/rust-deps-sync.jinja' %}

# Man page generation and installation
generate-man-pages:
    @just _devbox generate-man-pages_impl

[private]
generate-man-pages_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Generate man pages from template
    MAN_DIR="docs/man"
    OUTPUT_DIR="target/man"

    # Create output directory
    mkdir -p "$OUTPUT_DIR"

    # Process man page template
    if [ -f "$MAN_DIR/{{ project_slug }}.1.jinja" ]; then
        # For template-based approach, we'd use copier to render
        # For now, copy the template as-is (will be rendered during project generation)
        cp "$MAN_DIR/{{ project_slug }}.1.jinja" "$OUTPUT_DIR/{{ project_slug }}.1"
        log_end "Man page template copied to $OUTPUT_DIR/{{ project_slug }}.1"
    else
        log_warn "Man page template not found at $MAN_DIR/{{ project_slug }}.1.jinja"
    fi

install-man-pages:
    @just _devbox install-man-pages_impl

[private]
install-man-pages_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Install man pages to system man directory
    MAN_DIR="target/man"
    MAN_PATH="${MANPATH:-/usr/local/share/man}"

    if [ ! -d "$MAN_DIR" ]; then
        log_warn "Man pages not generated. Run 'just generate-man-pages' first."
        exit 1
    fi

    # Install man page (requires sudo)
    log_info "Installing man page to $MAN_PATH/man1/"
    sudo mkdir -p "$MAN_PATH/man1/"
    sudo cp "$MAN_DIR/{{ project_slug }}.1" "$MAN_PATH/man1/"
    sudo mandb
    log_end "Man page installed. Try 'man {{ project_slug }}' to view it."

validate-man-pages:
    @just _devbox validate-man-pages_impl

[private]
validate-man-pages_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    # Validate man page format using man command
    MAN_DIR="target/man"
    MAN_FILE="$MAN_DIR/{{ project_slug }}.1"

    if [ ! -f "$MAN_FILE" ]; then
        log_warn "Man page not found. Run 'just generate-man-pages' first."
        exit 1
    fi

    log_info "Validating man page format..."

    # Check if man command can parse the file
    if command -v man >/dev/null 2>&1; then
        # Use man --warnings to check for formatting issues
        if man --warnings --local-file "$MAN_FILE" 2>&1 | grep -q "warning"; then
            log_warn "Man page has formatting warnings:"
            man --warnings --local-file "$MAN_FILE" 2>&1 | grep "warning"
        else
            log_end "Man page format is valid"
        fi
    else
        log_warn "man command not available, skipping format validation"
    fi

    # Check for required sections
    log_info "Checking for required sections..."
    REQUIRED_SECTIONS=("NAME" "SYNOPSIS" "DESCRIPTION" "OPTIONS" "EXAMPLES" "EXIT STATUS" "ENVIRONMENT" "FILES" "BUGS" "SEE ALSO")
    for section in "${REQUIRED_SECTIONS[@]}"; do
        if grep -q "\.SH $section" "$MAN_FILE"; then
            log_info "  ✅ $section section found"
        else
            log_error "  $section section missing"
            exit 1
        fi
    done

    log_end "Man page validation complete"


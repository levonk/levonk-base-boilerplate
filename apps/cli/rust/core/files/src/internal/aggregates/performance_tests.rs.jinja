/// Performance tests for aggregate queries
///
/// Benchmarks aggregate computation performance to ensure
/// aggregates don't significantly impact query performance.

use super::{counter::*, derived::*};
use std::time::Instant;

#[test]
fn test_counter_backend_count_performance() {
    let counter = Counter::new();
    let start = Instant::now();

    for _ in 0..1000 {
        let _ = counter.compute_from_backend(847);
    }

    let duration = start.elapsed();
    // Should complete 1000 operations in less than 10ms
    assert!(duration.as_millis() < 10, "Backend count too slow: {:?}", duration);
}

#[test]
fn test_counter_in_memory_count_performance() {
    let counter = Counter::new();
    let items = vec![(); 10000];
    let start = Instant::now();

    for _ in 0..100 {

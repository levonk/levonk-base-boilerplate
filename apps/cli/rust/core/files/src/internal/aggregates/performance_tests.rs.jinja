#[test]
fn test_counter_lazy_computation_overhead() {
    let lazy_counter = Counter::new().with_lazy(true);
    let eager_counter = Counter::new().with_lazy(false);

    let start = Instant::now();
    for _ in 0..1000 {
        let _ = lazy_counter.compute_from_backend(847);
    }
    let lazy_duration = start.elapsed();

    let start = Instant::now();
    for _ in 0..1000 {
        let _ = eager_counter.compute_from_backend(847);
    }
    let eager_duration = start.elapsed();

    // Lazy should not add significant overhead
    let overhead = lazy_duration.saturating_sub(eager_duration);
    assert!(overhead.as_micros() < 1000, "Lazy computation overhead too high: {:?}", overhead);
}


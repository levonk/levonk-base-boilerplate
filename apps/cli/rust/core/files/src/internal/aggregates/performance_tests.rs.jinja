    for _ in 0..10000 {
        let _ = counter.backend_count_supported();
        let _ = counter.optimal_strategy();
    }

    let duration = start.elapsed();
    // Should complete 20000 checks in less than 10ms
    assert!(duration.as_millis() < 10, "Capability checks too slow: {:?}", duration);
}

#[test]
fn test_large_scale_aggregate_computation() {
    let counter = Counter::new();
    let computer = DerivedFieldComputer::new();

    let start = Instant::now();

    // Simulate processing 1000 items with aggregates
    for i in 0..1000 {
        let _ = counter.compute_from_backend(i);
        let _ = computer.compute_test_summary(i % 10, 10);
        let _ = computer.compute_comment_count(i % 20);
    }

    let duration = start.elapsed();
    // Should complete 1000 aggregate computations in less than 100ms
    assert!(duration.as_millis() < 100, "Large-scale computation too slow: {:?}", duration);
}

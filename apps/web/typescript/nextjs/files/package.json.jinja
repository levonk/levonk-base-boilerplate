{
  "name": "{{ package_name }}",
  "version": "0.0.1",
  "sha-version": "$Id$",
  "private": true,
  "description": "{{ description }}",
  "type": "module",
  "scripts": {
    "preinstall": "pnpm dlx only-allow pnpm",
    "dev": "portless {{ package_name }} next dev --turbopack",
    "watchmode": "node --watch-path=. --watch-extensions=ts,tsx,js,jsx,json --eval 'console.log(\"Node watchmode active. Monitoring for changes...\")'",
    "build": "next build",
    "optimize-images": "node scripts/optimize-images.ts",
    "yakbak:record": "node scripts/yakbak-proxy.mjs",
    "yakbak:replay": "YAKBAK_NO_RECORD=1 node scripts/yakbak-proxy.mjs",
    "start": "next start",
    "export": "next build && next export",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .next",
    "clean:hard": "rm -rf dist .next node_modules",
    "test": "vitest run",
    "test:performance": "vitest run --project performance",
    "test:integration": "vitest run --project integration",
    "test:e2e:requirements": "vitest run --project e2e-requirements",
    "test:e2e:usecases": "vitest run --project e2e-usecases",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:setup": "pnpm exec tsx lib/db/setup.ts",
    "db:seed": "pnpm exec tsx lib/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "next": "catalog:",
    "@job-aide/tools-platform-next-config": "workspace:*",
    "@antfu/ni": "catalog:",
    "react": "catalog:",
    "better-auth": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "bcryptjs": "catalog:",
    "better-all": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "dotenv": "catalog:",
    "drizzle-kit": "catalog:",
    "jose": "catalog:",
    "lucide-react": "catalog:",
    "only-allow": "catalog:",
    "postgres": "catalog:",
    "radix-ui": "catalog:",
    "server-only": "catalog:",
    "stripe": "catalog:",
    "swr": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    {% include "partials.bak/partials/package-json-partials/package-json-global-devdependencies.partial.json.jinja" %}
    "@browserbasehq/stagehand": "catalog:",
    "@job-aide/tools-lint-eslint-config": "workspace:*",
    "@job-aide/tools-css-config": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@tobilu/qmd": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "autoprefixer": "catalog:",
    "boneyard-js": "catalog:",
    "eslint-config-next": "catalog:",
    "globby": "catalog:",
    "imagemin": "catalog:",
    "imagemin-mozjpeg": "catalog:",
    "imagemin-pngquant": "catalog:",
    "imagemin-webp": "catalog:",
    "jsdom": "catalog:",
    "modern-errors": "catalog:",
    "modern-errors-beautiful": "catalog:",
    "modern-errors-bugs": "catalog:",
    "modern-errors-clean": "catalog:",
    "modern-errors-cli": "catalog:",
    "modern-errors-process": "catalog:",
    "modern-errors-serialize": "catalog:",
    "modern-errors-winston": "catalog:",
    "only-allow": "catalog:",
    "portless": "catalog:",
    "postcss": "catalog:",
    "skillman": "catalog:",
    "skills-detector": "catalog:",
    "tailwindcss": "catalog:",
    "yakbak": "catalog:"
  },
  {% include "partials.bak/partials/package-json-partials/package-json-tooling.partial.json.jinja" %}
  "modeline": "/* vim: set ft=json: */"
}

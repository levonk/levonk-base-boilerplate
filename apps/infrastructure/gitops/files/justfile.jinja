    kubectl diff -k deploy/apps/{{ project_slug }}/overlays/dev
    log_end "Kustomize diff complete"

[private]
kubeval_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Validating with kubeval"
    kubeval --strict deploy/apps/{{ project_slug }}/base/kustomization.yaml
    log_end "kubeval complete"

[private]
kubeconform_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Validating with kubeconform"
    kubeconform --strict deploy/apps/{{ project_slug }}/base/kustomization.yaml
    log_end "kubeconform complete"

[private]
kube-score_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Scoring with kube-score"
    kube-score score deploy/apps/{{ project_slug }}/base/kustomization.yaml
    log_end "kube-score complete"

[private]
argocd-generate_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Generating ArgoCD manifests"
    kubectl apply -f deploy/argocd/{{ project_slug }}/
    log_end "ArgoCD manifests generated"

[private]
argocd-sync_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Syncing ArgoCD applications"
    argocd app sync {{ project_name }}
    argocd app sync {{ project_name }}-staging
    argocd app sync {{ project_name }}-prod
    log_end "ArgoCD sync complete"

[private]
argocd-status_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    argocd app get {{ project_name }}
    argocd app get {{ project_name }}-staging
    argocd app get {{ project_name }}-prod

[private]
argocd-port-forward_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Port forwarding ArgoCD UI"
    kubectl port-forward -n argocd svc/argocd-server 8080:443

[private]
flux-generate_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Generating Flux manifests"
    flux create kustomization {{ project_name }} \
        --source=GitRepository/{{ project_name }} \
        --path="./deploy/apps/{{ project_slug }}/overlays/dev" \
        --prune=true \
        --interval=5m
    log_end "Flux manifests generated"

[private]
flux-sync_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Syncing Flux resources"
    flux reconcile kustomization {{ project_name }}
    log_end "Flux sync complete"

[private]
flux-status_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    flux get kustomizations
    flux get helmreleases

{% if enable_docker %}
[private]
docker-build_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Building Docker image"
    docker build -t {{ app_image }}:{{ app_version }} .
    docker tag {{ app_image }}:{{ app_version }} {{ app_image }}:latest
    log_end "Docker image built"

[private]
docker-push_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Pushing Docker image"
    docker push {{ app_image }}:{{ app_version }}
    docker push {{ app_image }}:latest
    log_end "Docker image pushed"
{% endif %}

[private]
pre-commit_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Running pre-commit hooks"
    pre-commit run --all-files
    log_end "Pre-commit complete"

[private]
pre-commit-install_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Installing pre-commit hooks"
    pre-commit install
    log_end "Pre-commit hooks installed"

[private]
deps-update_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Updating dependencies"
    helm dependency update deploy/charts/{{ project_slug }}/
    log_end "Dependencies updated"

[private]
security-scan_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Running security scan"
    trivy image {{ app_image }}:{{ app_version }}
    log_end "Security scan complete"

[private]
sbom_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Generating SBOM"
    syft {{ app_image }}:{{ app_version }} -o sbom.json
    log_end "SBOM generated"

[private]
ci_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    just validate_impl
    just test_impl
    just security-scan_impl
    log_end "CI pipeline completed successfully"

[private]
deploy_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    just deploy-dev_impl
    just deploy-staging_impl
    just deploy-prod_impl
    log_end "All deployments completed successfully"


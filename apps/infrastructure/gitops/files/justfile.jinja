    log_end "Helm package complete"

[private]
helm-install_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Installing Helm chart"
    helm install {{ project_name }} deploy/charts/{{ project_slug }}/
    log_end "Helm install complete"

[private]
helm-upgrade_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Upgrading Helm chart"
    helm upgrade {{ project_name }} deploy/charts/{{ project_slug }}/
    log_end "Helm upgrade complete"

[private]
helm-uninstall_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Uninstalling Helm chart"
    helm uninstall {{ project_name }}
    log_end "Helm uninstall complete"

[private]
kustomize-build_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Building Kustomize overlays"
    echo "Development:"
    kustomize build deploy/apps/{{ project_slug }}/overlays/dev
    echo "Staging:"
    kustomize build deploy/apps/{{ project_slug }}/overlays/staging
    echo "Production:"
    kustomize build deploy/apps/{{ project_slug }}/overlays/prod
    log_end "Kustomize build complete"

[private]
kustomize-apply_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Applying Kustomize overlays"
    kubectl apply -k deploy/apps/{{ project_slug }}/overlays/dev
    log_end "Kustomize apply complete"

[private]
kustomize-diff_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}

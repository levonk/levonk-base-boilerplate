# Justfile for {{ project_name }}
# Run `just --list` to see available commands
#
# Output is quiet by default (warnings + errors only).
# Set JUST_LOG=1 for all output, JUST_LOG=startend for start/end markers.

{% include "partials.bak/partials/justfile-partials/logging.jinja" %}

# Devbox auto-detection: run impl target directly if in devbox,
# re-exec via devbox run if not, or fail with doctor diagnostic.
_devbox target *args:
    #!/usr/bin/env bash
    {{_log}}
    if [ "${DEVBOX_SHELL_ENABLED:-0}" = "1" ]; then
        exec just "{{target}}" {{args}}
    elif command -v devbox >/dev/null 2>&1; then
        exec devbox run -- just "{{target}}" {{args}}
    else
        log_error "devbox not found in PATH."
        log_warn "Running doctor to diagnose environment issues..."
        just doctor 2>/dev/null || true
        exit 1
    fi

# Default recipe
default:
    @just --list

# --- public targets (devbox-aware) ------------------------------------------

# Set up development environment.
setup:
    @just _devbox setup_impl

# Validate all configurations.
validate:
    @just _devbox validate_impl

# Run tests.
test:
    @just _devbox test_impl

# Clean up all resources.
clean:
    @just _devbox clean_impl

# Deploy to development environment.
deploy-dev:
    @just _devbox deploy-dev_impl

# Deploy to staging environment.
deploy-staging:
    @just _devbox deploy-staging_impl

# Deploy to production environment.
deploy-prod:
    @just _devbox deploy-prod_impl

# Check deployment status.
status:
    @just _devbox status_impl

# Get logs.
logs:
    @just _devbox logs_impl

# Port forward service.
port-forward:
    @just _devbox port-forward_impl

# Build and lint Helm chart.
helm-lint:
    @just _devbox helm-lint_impl

# Template Helm chart.
helm-template:
    @just _devbox helm-template_impl

# Package Helm chart.
helm-package:
    @just _devbox helm-package_impl

# Install Helm chart locally.
helm-install:
    @just _devbox helm-install_impl

# Upgrade Helm chart.
helm-upgrade:
    @just _devbox helm-upgrade_impl

# Uninstall Helm chart.
helm-uninstall:
    @just _devbox helm-uninstall_impl

# Build Kustomize overlays.
kustomize-build:
    @just _devbox kustomize-build_impl

# Apply Kustomize overlays.
kustomize-apply:
    @just _devbox kustomize-apply_impl

# Diff Kustomize overlays.
kustomize-diff:
    @just _devbox kustomize-diff_impl

# Validate with kubeval.
kubeval:
    @just _devbox kubeval_impl

# Validate with kubeconform.
kubeconform:
    @just _devbox kubeconform_impl

# Score with kube-score.
kube-score:
    @just _devbox kube-score_impl

# Generate ArgoCD manifests.
argocd-generate:
    @just _devbox argocd-generate_impl

# Sync ArgoCD applications.
argocd-sync:
    @just _devbox argocd-sync_impl

# Get ArgoCD application status.
argocd-status:
    @just _devbox argocd-status_impl

# Port forward ArgoCD UI.
argocd-port-forward:
    @just _devbox argocd-port-forward_impl

# Generate Flux manifests.
flux-generate:
    @just _devbox flux-generate_impl

# Sync Flux resources.
flux-sync:
    @just _devbox flux-sync_impl

# Get Flux status.
flux-status:
    @just _devbox flux-status_impl

{% if enable_docker %}
# Build Docker image.
docker-build:
    @just _devbox docker-build_impl

# Push Docker image.
docker-push:
    @just _devbox docker-push_impl
{% endif %}

# Run pre-commit hooks.
pre-commit:
    @just _devbox pre-commit_impl

# Install pre-commit hooks.
pre-commit-install:
    @just _devbox pre-commit-install_impl

# Update dependencies.
deps-update:
    @just _devbox deps-update_impl

# Security scan.
security-scan:

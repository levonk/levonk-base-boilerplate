    helm unittest deploy/charts/{{ project_slug }}/ --strict --output-file test-report.html
    log_end "HTML test report generated"

[private]
test-report-junit_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Generating JUnit test report"
    helm unittest deploy/charts/{{ project_slug }}/ --strict --output-file test-report.xml
    log_end "JUnit test report generated"

[private]
test-cleanup_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Cleaning up test artifacts"
    rm -f test-report.* coverage.* unittest-report.*
    log_end "Test cleanup complete"

[private]
test-setup_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Setting up test environment"
    helm plugin install https://github.com/helm-unittest/helm-unittest
    log_end "Test environment setup complete"


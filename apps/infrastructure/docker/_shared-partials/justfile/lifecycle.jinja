up: ## Start {{ _service_name | title }} services
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Starting {{ _service_name | title }} services"
    docker compose -f {{ COMPOSE_FILE }} --env-file {{ ENV_FILE }} up -d
    log_end "Services started"
    log_info "Run 'just health-check' to verify service health"

run: up ## Alias for up (ADR compliance)

deploy: ## Deploy {{ _service_name | title }} services (alias for up)
    @just up

debug: ## Start {{ _service_name | title }} debug container (opt-in)
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Starting {{ _service_name | title }} debug container"
    docker compose -f {{ COMPOSE_FILE }} --env-file {{ ENV_FILE }} --profile debug up -d
    log_end "Debug container started"

down: ## Stop {{ _service_name | title }} services
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Stopping {{ _service_name | title }} services"
    docker compose -f {{ COMPOSE_FILE }} --env-file {{ ENV_FILE }} down
    log_end "Services stopped"

restart: ## Restart {{ _service_name | title }} services
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Restarting {{ _service_name | title }} services"
    docker compose -f {{ COMPOSE_FILE }} --env-file {{ ENV_FILE }} restart
    log_end "Services restarted"

logs: ## View logs from all services (last 100 lines)
    @docker compose -f {{ COMPOSE_FILE }} --env-file {{ ENV_FILE }} logs --tail=100

logs-follow: ## Follow logs from all services
    @docker compose -f {{ COMPOSE_FILE }} --env-file {{ ENV_FILE }} logs -f

shell: ## Access an interactive shell inside the service container
    @docker compose -f {{ COMPOSE_FILE }} --env-file {{ ENV_FILE }} exec -it {{ SERVICE_NAME }} /bin/sh

health-check: ## Check health status of services
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Checking {{ _service_name | title }} service health"
    docker compose -f {{ COMPOSE_FILE }} --env-file {{ ENV_FILE }} ps
    log_info "Running health checks..."
    docker compose -f {{ COMPOSE_FILE }} --env-file {{ ENV_FILE }} exec -T {{ SERVICE_NAME }} curl -f http://localhost:{{ SERVICE_PORT }}{{ SERVICE_HEALTH_ENDPOINT }} >/dev/null 2>&1 \
        && log_end "{{ _service_name | title }} healthy" \
        || { log_error "{{ _service_name | title }} unhealthy"; exit 1; }

test: ## Smoke test that services are running and responsive
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Running {{ _service_name | title }} smoke tests"
    docker compose -f {{ COMPOSE_FILE }} --env-file {{ ENV_FILE }} ps | grep -q "{{ SERVICE_NAME }}" || { log_error "services not running"; exit 1; }
    just health-check
    log_end "Smoke tests complete"

status: ## Show docker compose service status
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_info "{{ _service_name | title }} Service Status"
    docker compose -f {{ COMPOSE_FILE }} --env-file {{ ENV_FILE }} ps

backup: ## Create secure backup of service data and configuration
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Creating backup of {{ _service_name | title }} service"
    ./scripts/backup.sh
    log_end "Backup completed"

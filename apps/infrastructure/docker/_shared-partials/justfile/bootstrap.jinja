bootstrap: ## Install dependencies and setup environment (Nix + direnv)
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Bootstrapping environment"
    if ! command -v nix >/dev/null; then
        log_warn "Installing Nix..."
        curl --proto '=https' --tlsv1.2 -sSf -L https://install.determinate.systems/nix | sh -s -- install
    fi
    if ! command -v direnv >/dev/null; then
        log_warn "Installing direnv..."
        nix profile install nixpkgs#direnv
    fi
    direnv allow
    log_end "Environment bootstrapped. Run 'direnv allow' if prompted again."

doctor: ## Check health of the dev environment
    @echo "Checking environment health..."
    @command -v nix >/dev/null && echo "✓ Nix installed" || echo "✗ Nix missing"
    @command -v direnv >/dev/null && echo "✓ direnv installed" || echo "✗ direnv missing"
    @command -v docker >/dev/null && echo "✓ Docker installed" || echo "✗ Docker missing"
    @(docker compose version >/dev/null 2>&1 || docker-compose version >/dev/null 2>&1) && echo "✓ Docker Compose installed" || echo "✗ Docker Compose missing"

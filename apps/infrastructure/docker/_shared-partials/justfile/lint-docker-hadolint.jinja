lint-docker:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    if [ -f "{{ DOCKERFILE_PATH }}" ]; then
        log_start "Running hadolint on {{ DOCKERFILE_PATH }}"
        docker run --rm -v {{ WORKDIR }}:/workspace -w /workspace --security-opt=no-new-privileges {{ HADOLINT_IMAGE }} {{ DOCKERFILE_PATH }}
    else
        log_warn "No Dockerfile found at {{ DOCKERFILE_PATH }}; skipping hadolint"
    fi

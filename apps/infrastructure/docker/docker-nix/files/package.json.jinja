{
  "name": "docker-nix",
  "version": "1.0.0",
  "description": "Docker Nix container with NX monorepo support",
  "scripts": {
    "build": "docker compose build",
    "build:all": "docker compose build",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "clean": "docker compose down -v"
  },
  "devDependencies": {
    "@nx-tools/nx-container": "catalog:",
    "@nx/js": "catalog:",
    "nx": "catalog:"
  },
  "packageManager": "pnpm@*"
}

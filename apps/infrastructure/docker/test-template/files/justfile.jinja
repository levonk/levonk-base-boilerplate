# Docker Test Template Development Commands

{% include "partials.bak/partials/justfile-partials/logging.jinja" %}

# Devbox auto-detection: run impl target directly if in devbox,
# re-exec via devbox run if not, or fail with doctor diagnostic.
_devbox target *args:
    #!/usr/bin/env bash
    {{_log}}
    if [ "${DEVBOX_SHELL_ENABLED:-0}" = "1" ]; then
        exec just "{{target}}" {{args}}
    elif command -v devbox >/dev/null 2>&1; then
        exec devbox run -- just "{{target}}" {{args}}
    else
        log_error "devbox not found in PATH."
        log_warn "Running doctor to diagnose environment issues..."
        just doctor 2>/dev/null || true
        exit 1
    fi

# Default recipe
default:
    @just --list

# Standard development recipes (REQUIRED)
clean:
    @just _devbox clean_impl

dev:
    @just _devbox dev_impl

build:
    @just _devbox build_impl

test:
    @just _devbox test_impl

lint:
    @just _devbox lint_impl

typecheck:
    @just _devbox typecheck_impl

# Bootstrap recipes (REQUIRED)
bootstrap:
    @just _devbox bootstrap_impl

[private]
bootstrap_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_info "Docker Test template bootstrap complete"

# Health and diagnostics (REQUIRED)
doctor:
    # Check Docker Test environment
    @echo "🧪 Docker version:"
    @docker --version
    @echo ""
    @echo "🛠️  Development tools:"
    @command -v just || echo "just not found"
    @echo ""
    @echo "✅ Docker Test environment is ready!"

# Development mode
[private]
dev_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Starting Docker Test development mode"
    just build_impl
    just test_impl
    log_end "Docker Test development mode started"

# Build Docker image
[private]
build_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Building Docker image"
    docker build -t test-template .
    log_end "Docker build complete"

# Run tests
[private]
test_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Running tests"
    docker run --rm test-template pytest
    log_end "Tests complete"

# Run tests in interactive mode
test-interactive:
    @just _devbox test-interactive_impl

[private]
test-interactive_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    docker run -it --rm test-template /bin/bash

# Clean up
[private]
clean_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Cleaning up"
    docker system prune -f
    log_end "Clean complete"

# Development setup
setup:
    @just _devbox setup_impl

[private]
setup_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    just bootstrap_impl
    log_end "Docker Test template development environment ready"

# Health check
health:
    @just _devbox health_impl

[private]
health_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_info "Docker Test template environment is ready"

# Execute command in container
exec command="/bin/bash":
    @just _devbox exec_impl {{command}}

[private]
exec_impl command:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    docker run -it --rm test-template {{command}}

# Lint Docker files
[private]
lint_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Linting Docker files"
    hadolint Dockerfile
    log_end "Lint complete"

# Type check
[private]
typecheck_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_info "Type checking not applicable for Docker Test template"

# Package for distribution
package:
    @just _devbox package_impl

[private]
package_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Packaging for distribution"
    just build_impl
    just clean_impl
    mkdir -p dist
    docker save test-template:latest > dist/test-template.tar
    log_end "Package complete"

# Quality checks
quality:
    @just _devbox quality_impl

[private]
quality_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    just lint_impl
    just test_impl
    just health_impl

# View logs
logs:
    @just _devbox logs_impl

[private]
logs_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    docker logs -f $(docker ps -q --filter "name=test-template")

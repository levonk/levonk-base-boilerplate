# Airflow Project Development Commands

# Detect NX binary
NX_BIN := `command -v nx || echo ""`
NX_AVAILABLE := if NX_BIN != "" { "true" } else { "false" }

_log := '
_jv_has() {
  local cat="$1"
  local v="${JUST_LOG:-0}"
  case "$v" in
    1|all) return 0 ;;
    0|"") return 1 ;;
  esac
  v="${v//startend/start,end}"
  echo ",$v," | grep -q ",$cat,"
}
log_info()   { _jv_has info   && echo "$*" || true; }
log_start()  { _jv_has start  && echo "▶ $*" || true; }
log_end()    { _jv_has end    && echo "✔ $*" || true; }
log_status() { _jv_has status && echo "$*" || true; }
log_warn()   { echo "⚠️  $*" >&2; }
log_error()  { echo "❌ $*" >&2; }
log_startend() {
  local msg="$1"; shift
  local rc
  _jv_has start && echo "▶ $msg" || true
  rc=0; "$@" || rc=$?
  _jv_has end && echo "✔ $msg complete" || true
  return $rc
}
'

# Devbox auto-detection: run impl target directly if in devbox,
# re-exec via devbox run if not, or fail with doctor diagnostic.
_devbox target *args:
    #!/usr/bin/env bash
    {{_log}}
    if [ "${DEVBOX_SHELL_ENABLED:-0}" = "1" ]; then
        exec just "{{target}}" {{args}}
    elif command -v devbox >/dev/null 2>&1; then
        exec devbox run -- just "{{target}}" {{args}}
    else
        log_error "devbox not found in PATH."
        log_warn "Running doctor to diagnose environment issues..."
        just doctor 2>/dev/null || true
        exit 1
    fi

# Default recipe
default:
    @just --list

# Standard development recipes (REQUIRED)
clean:
    @just _devbox clean_impl

dev:
    @just _devbox dev_impl

build:
    @just _devbox build_impl

test:
    @just _devbox test_impl

lint:
    @just _devbox lint_impl

typecheck:
    @just _devbox typecheck_impl

# Bootstrap recipes (REQUIRED)
bootstrap:
    @just _devbox bootstrap_impl

[private]
bootstrap_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Installing pnpm and NX"
    npm install -g pnpm@latest
    if [ "{{ NX_AVAILABLE }}" = "false" ]; then pnpm add -g nx@latest; fi
    pnpm install
    log_end "Bootstrap complete"

# NX Commands
[private]
nx-build_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    if [ "{{ NX_AVAILABLE }}" = "true" ]; then nx build; else log_info "Use just build"; fi

[private]
nx-test_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    if [ "{{ NX_AVAILABLE }}" = "true" ]; then nx test; else log_info "Use just test"; fi

[private]
nx-lint_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    if [ "{{ NX_AVAILABLE }}" = "true" ]; then nx lint; else log_info "Use just lint"; fi

[private]
nx-affected_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    if [ "{{ NX_AVAILABLE }}" = "true" ]; then nx affected; else log_info "NX not available"; fi

[private]
nx-graph_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    if [ "{{ NX_AVAILABLE }}" = "true" ]; then nx graph; else log_info "NX not available"; fi

[private]
nx-clear-cache_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    if [ "{{ NX_AVAILABLE }}" = "true" ]; then nx reset; else log_info "NX not available"; fi

nx-build:
    @just _devbox nx-build_impl

nx-test:
    @just _devbox nx-test_impl

nx-lint:
    @just _devbox nx-lint_impl

nx-affected:
    @just _devbox nx-affected_impl

nx-graph:
    @just _devbox nx-graph_impl

nx-clear-cache:
    @just _devbox nx-clear-cache_impl

[private]
nx-install_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    pnpm add -g nx@latest
    log_end "NX installed globally"

nx-install:
    @just _devbox nx-install_impl

# Health and diagnostics (REQUIRED)
doctor:
    # Check Airflow Project environment
    @echo "🌪️ Airflow version:"
    @airflow version
    @echo ""
    @echo "🐳 Docker version:"
    @docker --version
    @echo ""
    @echo "🛠️  Development tools:"
    @command -v just || echo "just not found"
    @echo ""
    @echo "📦 Node environment:"
    @node --version
    @pnpm --version
    @echo "📊 NX: {{ if NX_AVAILABLE }}$(nx --version){{ else }}not installed{{ endif }}"
    @echo ""
    @echo "✅ Airflow Project environment is ready!"

# Development mode
[private]
dev_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Starting Airflow development mode"
    just bootstrap_impl
    just airflow-init
    just airflow-start
    log_end "Airflow development mode started"

# Initialize Airflow
airflow-init:
    airflow db init

# Start Airflow webserver and scheduler
airflow-start:
    airflow webserver --port 8080 &
    airflow scheduler

# Stop Airflow services
airflow-stop:
    #!/usr/bin/env bash
    {{_log}}
    pkill -f "airflow webserver" || log_info "Webserver not running"
    pkill -f "airflow scheduler" || log_info "Scheduler not running"

# Run Airflow webserver only
webserver:
    airflow webserver --port 8080

# Run Airflow scheduler only
scheduler:
    airflow scheduler

# Run tests
[private]
test_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Running tests"
    pytest tests/
    log_end "Tests complete"

# Run tests with coverage
test-coverage:
    @just _devbox test-coverage_impl

[private]
test-coverage_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Running tests with coverage"
    pytest --cov=dags --cov-report=html
    log_end "Tests with coverage complete"

# Lint code
[private]
lint_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Linting code"
    flake8 dags/
    black --check dags/
    isort --check-only dags/
    log_end "Lint complete"

# Format code
format:
    @just _devbox format_impl

[private]
format_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Formatting code"
    black dags/
    isort dags/
    log_end "Format complete"

# Type checking
[private]
typecheck_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Type checking"
    mypy dags/
    log_end "Type check complete"

# Build for production
[private]
build_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_info "Airflow project build complete"

# Clean up
[private]
clean_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Cleaning up"
    just airflow-stop
    rm -rf .pytest_cache .coverage htmlcov
    airflow db reset --yes
    log_end "Clean complete"

# Development setup
setup:
    @just _devbox setup_impl

[private]
setup_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    just bootstrap_impl
    log_end "Airflow Project development environment ready"

# Health check
health:
    @just _devbox health_impl

[private]
health_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    curl -f http://localhost:8080/health || log_warn "Airflow not running"

# Package for distribution
package:
    @just _devbox package_impl

[private]
package_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Packaging for distribution"
    just build_impl
    just clean_impl
    mkdir -p dist
    tar -czf dist/{{ project_name }}.tar.gz dags/ requirements.txt
    log_end "Package complete"

# Quality checks
quality:
    @just _devbox quality_impl

[private]
quality_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    just lint_impl
    just test_impl
    just health_impl

# Docker commands
docker-build:
    @just _devbox docker-build_impl

[private]
docker-build_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Building Docker image"
    docker build -t {{ project_name }} .
    log_end "Docker build complete"

docker-run:
    @just _devbox docker-run_impl

[private]
docker-run_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Running Docker container"
    docker run -p 8080:8080 {{ project_name }}
    log_end "Docker run complete"

# View logs
logs:
    @just _devbox logs_impl

[private]
logs_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_info "Airflow logs:"
    tail -f $AIRFLOW_HOME/logs/airflow-scheduler.log || log_info "Scheduler logs not found"
    tail -f $AIRFLOW_HOME/logs/airflow-webserver.log || log_info "Webserver logs not found"

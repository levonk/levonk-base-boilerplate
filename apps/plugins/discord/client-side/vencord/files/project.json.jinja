{
  "name": "{{ project_name | default('vencord-plugin') }}",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "src",
  "projectType": "application",
  "targets": {
    {% include "partials.bak/partials/nx-partials/nx-target-nodejs-test.jinja" %}
    {% include "partials.bak/partials/nx-partials/nx-target-nodejs-lint.jinja" %}
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "link": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run link:vencord",
        "cwd": "{projectRoot}"
      }
    }
  }
}

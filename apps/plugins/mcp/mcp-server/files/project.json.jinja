{
  "name": "{{ package_name }}",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "src",
  "projectType": "application",
  "targets": {
    {% include "partials.bak/partials/nx-partials/nx-target-nodejs-test.jinja" %}
    {% include "partials.bak/partials/nx-partials/nx-target-nodejs-lint.jinja" %}
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "{projectRoot}"
      }
    }
  }
}
